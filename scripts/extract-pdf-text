#!/usr/bin/env python3
"""Extract page-bounded PDF text into deterministic, reviewable evidence."""
import argparse
import hashlib
import json
import os
import pathlib
import re
import subprocess
import sys
import tempfile
import unicodedata


DASHES = str.maketrans({chr(point): "-" for point in range(0x110000)
                         if unicodedata.category(chr(point)) == "Pd"} | {"\u2212": "-"})


def sha256_file(path):
    hasher = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            hasher.update(chunk)
    return hasher.hexdigest()


def sha256_bytes(value):
    return hashlib.sha256(value).hexdigest()


def aliases(first, second):
    if first.exists() and second.exists() and os.path.samefile(first, second):
        return True
    return first.resolve(strict=False) == second.resolve(strict=False)


def run(command):
    return subprocess.run(command, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def page_count(source):
    result = run(["pdfinfo", str(source)])
    match = re.search(rb"^Pages:\s*(\d+)\s*$", result.stdout, re.MULTILINE)
    if not match or int(match.group(1)) < 1:
        raise ValueError("pdfinfo did not report a positive page count")
    return int(match.group(1))


def atomic_write(destination, body):
    destination.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{destination.name}.", dir=destination.parent)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(body)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, destination)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("input", type=pathlib.Path)
    parser.add_argument("--output", required=True, type=pathlib.Path)
    parser.add_argument("--source-label", required=True)
    parser.add_argument("--force", action="store_true")
    args = parser.parse_args()
    if not args.input.is_file():
        raise ValueError(f"input is not a file: {args.input}")
    if aliases(args.input, args.output):
        raise ValueError("output aliases input")
    source_label = args.source_label.translate(DASHES)
    source_hash = sha256_file(args.input)

    count = page_count(args.input)
    pages = []
    for number in range(1, count + 1):
        result = run(["pdftotext", "-f", str(number), "-l", str(number), "-layout", str(args.input), "-"])
        text = result.stdout.decode("utf-8", errors="strict").translate(DASHES).strip()
        if not text:
            raise ValueError(f"page {number} produced no text")
        pages.append(f"===== PAGE {number} OF {count} =====\n{text}\n")

    if sha256_file(args.input) != source_hash:
        raise ValueError("source changed during extraction")
    body = (
        f"source_label: {source_label}\n"
        f"source_sha256: {source_hash}\n"
        f"page_count: {count}\n"
        "dash_normalization: unicode dashes replaced with ASCII hyphen\n\n"
        + "".join(pages)
    ).encode("utf-8")
    if args.output.exists() and args.output.read_bytes() != body and not args.force:
        raise FileExistsError(f"output already exists and does not match: {args.output}")
    if not args.output.exists() or args.output.read_bytes() != body:
        atomic_write(args.output, body)
    print(json.dumps({
        "kind": "pdf_text_extraction",
        "source_label": source_label,
        "source_sha256": source_hash,
        "page_count": count,
        "output": str(args.output),
        "output_sha256": sha256_bytes(body),
    }, separators=(",", ":")))


if __name__ == "__main__":
    try:
        main()
    except (OSError, subprocess.CalledProcessError, UnicodeError, ValueError) as error:
        print(f"extract-pdf-text: {error}", file=sys.stderr)
        sys.exit(1)
