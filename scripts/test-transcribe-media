#!/usr/bin/env python3
"""Black-box contract tests for scripts/transcribe-media.

Breaks named here: wrong pinned backend arguments, altered raw JSON, wrong
source hash, missing provenance/timestamps, non-atomic failure, and empty
states accepted as evidence.
"""
import hashlib
import importlib.machinery
import importlib.util
import json
import math
import os
import pathlib
import subprocess
import tempfile
import textwrap
import unittest
import unicodedata
from unittest import mock


ROOT = pathlib.Path(__file__).resolve().parent.parent
SCRIPT = ROOT / "scripts" / "transcribe-media"


class TranscribeMediaTests(unittest.TestCase):
    def make_stub(self, directory, name, body):
        path = pathlib.Path(directory) / name
        path.write_text("#!/usr/bin/env python3\n" + body, encoding="utf-8")
        path.chmod(0o755)

    def run_transcribe(self, source, markdown, raw, bin_dir, *extra, label="clip.mp4"):
        env = os.environ.copy()
        env["PATH"] = str(bin_dir) + os.pathsep + env["PATH"]
        return subprocess.run(
            [str(SCRIPT), str(source), "--output", str(markdown),
             "--json-output", str(raw), "--source-label", label, *extra],
            text=True, capture_output=True, env=env, check=False,
        )

    def install_success_backend(self, bins, fixture, argv_file=None, mutation=None):
        record = ""
        if argv_file:
            record = f"pathlib.Path({str(argv_file)!r}).write_text(json.dumps(sys.argv[1:]))"
        mutate = ""
        if mutation:
            mutate = f"pathlib.Path({str(mutation)!r}).write_bytes(b'changed')"
        self.make_stub(bins, "uvx", textwrap.dedent(f"""\
            import json, pathlib, sys
            {record}
            {mutate}
            out = pathlib.Path(sys.argv[sys.argv.index('--output-dir') + 1])
            out.mkdir(parents=True, exist_ok=True)
            (out / 'clip.json').write_bytes({fixture!r})
        """))

    def test_preserves_raw_json_and_writes_timestamped_machine_only_markdown(self):
        """Would fail if ASR args, raw JSON, source hash, timestamps, or warning change."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source = root / "clip.mp4"
            source.write_bytes(b"synthetic media")
            markdown, raw = root / "clip.md", root / "clip.json"
            argv_file = root / "uvx-argv.json"
            fixture = '{\n  "segments": [{"start": 0.0, "end": 1.25, "text": "hello\u2014world", "tokens": [100], "words": [{"start": 0.0, "end": 1.25, "word": "hello\u2014world"}]}]\n}\n'.encode()
            self.make_stub(bins, "ffprobe", "print('12.5')\n")
            self.make_stub(bins, "uvx", textwrap.dedent(f"""\
                import json, pathlib, sys
                pathlib.Path({str(argv_file)!r}).write_text(json.dumps(sys.argv[1:]))
                out = pathlib.Path(sys.argv[sys.argv.index('--output-dir') + 1])
                out.mkdir(parents=True, exist_ok=True)
                (out / 'clip.json').write_bytes({fixture!r})
            """))

            result = self.run_transcribe(source, markdown, raw, bins)

            self.assertEqual(result.returncode, 0, result.stderr)
            argv = json.loads(argv_file.read_text())
            self.assertEqual(argv[:-1], [
                "--from", "mlx-whisper==0.4.3", "mlx_whisper", str(source),
                "--model", "mlx-community/whisper-large-v3-turbo", "--task", "transcribe",
                "--language", "en", "--temperature", "0", "--word-timestamps",
                "True", "--output-format", "json", "--output-dir",
            ])
            self.assertTrue(argv[-1])
            expected_raw = json.dumps(json.loads(fixture), ensure_ascii=True, separators=(",", ":")).encode()
            self.assertEqual(raw.read_bytes(), expected_raw)
            self.assertEqual(json.loads(raw.read_bytes()), json.loads(fixture))
            self.assertIn(b"\\u2014", raw.read_bytes())
            expected_markdown = (
                "# Transcript: clip.mp4\n\n"
                "Machine transcript only. Not checked against the recording. No LLM editing was applied.\n\n"
                f"- Source SHA-256: `{hashlib.sha256(source.read_bytes()).hexdigest()}`\n"
                "- Duration seconds: `12.5`\n"
                "- Engine: `mlx-whisper==0.4.3`\n"
                "- Model: `mlx-community/whisper-large-v3-turbo`\n"
                "- Backend JSON encoding: ASCII escaped JSON preserving backend data.\n"
                "- Raw JSON order: original backend emission order.\n"
                "- Markdown order: chronologically sorted by union start, union end, then original backend index.\n"
                "- Unaligned segments: records without word alignment use segment-level timing.\n"
                "- backend_segment_count: `1`\n"
                "- rendered_segment_count: `1`\n"
                "- cleared_segment_count: `0`\n"
                "- unaligned_segment_count: `0`\n"
                "- reversed_timing_segment_count: `0`\n"
                "- emission_order_regressions: `0`\n"
                "- emission_overlap_count: `0`\n"
                "- backend_nonfinite_diagnostic_count: `0`\n"
                "- Dash normalization: Unicode dashes replaced with ASCII hyphen in Markdown only.\n\n"
                "## Segments\n\n"
                "[00:00.000 - 00:01.250] hello-world\n"
            ).encode()
            self.assertEqual(markdown.read_bytes(), expected_markdown)
            completion = json.loads(result.stdout)
            self.assertEqual(completion["kind"], "media_transcription")
            self.assertEqual(completion["source_sha256"], hashlib.sha256(source.read_bytes()).hexdigest())
            self.assertEqual(completion["duration_seconds"], 12.5)
            self.assertEqual(completion["json_output_sha256"], hashlib.sha256(expected_raw).hexdigest())
            self.assertEqual(completion["output_sha256"], hashlib.sha256(expected_markdown).hexdigest())

    def test_opt_in_unconditioned_decode_passes_flag_and_discloses_it(self):
        """Would fail if loop-recovery decoding is silent, mispositioned, or leaks into the default."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source = root / "clip.mp4"
            source.write_bytes(b"synthetic media")
            markdown, raw = root / "clip.md", root / "clip.json"
            argv_file = root / "uvx-argv.json"
            fixture = b'{"segments":[{"start":0,"end":1,"text":"ok","tokens":[100],"words":[{"start":0,"end":1,"word":"ok"}]}]}'
            self.make_stub(bins, "ffprobe", "print('12.5')\n")
            self.install_success_backend(bins, fixture, argv_file=argv_file)

            result = self.run_transcribe(source, markdown, raw, bins, "--no-condition-on-previous-text")

            self.assertEqual(result.returncode, 0, result.stderr)
            argv = json.loads(argv_file.read_text())
            self.assertEqual(argv[:-1], [
                "--from", "mlx-whisper==0.4.3", "mlx_whisper", str(source),
                "--model", "mlx-community/whisper-large-v3-turbo", "--task", "transcribe",
                "--language", "en", "--temperature", "0", "--word-timestamps",
                "True", "--condition-on-previous-text", "False",
                "--output-format", "json", "--output-dir",
            ])
            text = markdown.read_text()
            self.assertIn(
                "- Model: `mlx-community/whisper-large-v3-turbo`\n"
                "- Previous-text conditioning: `False`. Opt-in loop-recovery decode; the backend default is `True`.\n"
                "- Backend JSON encoding:",
                text,
            )
            completion = json.loads(result.stdout)
            self.assertIs(completion["condition_on_previous_text"], False)

            default_markdown, default_raw = root / "default.md", root / "default.json"
            default_result = self.run_transcribe(source, default_markdown, default_raw, bins)

            self.assertEqual(default_result.returncode, 0, default_result.stderr)
            self.assertNotIn("--condition-on-previous-text", json.loads(argv_file.read_text()))
            self.assertNotIn("Previous-text conditioning", default_markdown.read_text())
            self.assertIs(json.loads(default_result.stdout)["condition_on_previous_text"], True)

    def test_reports_loop_evidence_and_recovery_hint_without_changing_evidence(self):
        """Would fail if a mid-recording decoder loop is transcribed silently or the hint leaks into evidence."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source = root / "clip.mp4"
            source.write_bytes(b"media")
            self.make_stub(bins, "ffprobe", "print('400')\n")
            speech = [{"start": i * 5.0, "end": i * 5.0 + 5.0, "text": f" sentence {i}", "tokens": [100],
                       "words": [{"start": i * 5.0, "end": i * 5.0 + 5.0, "word": f" sentence {i}"}]}
                      for i in range(20)]
            loop = [{"start": 100 + i * 2.0, "end": 101 + i * 2.0, "text": " Save.", "tokens": [100],
                     "words": [{"start": 100 + i * 2.0, "end": 101 + i * 2.0, "word": " Save."}]}
                    for i in range(10)]
            self.install_success_backend(bins, json.dumps({"segments": speech + loop}).encode())

            looped = self.run_transcribe(source, root / "loop.md", root / "loop.json", bins)
            recovery = self.run_transcribe(source, root / "rec.md", root / "rec.json", bins,
                                           "--no-condition-on-previous-text")
            self.install_success_backend(bins, json.dumps({"segments": speech}).encode())
            clean = self.run_transcribe(source, root / "clean.md", root / "clean.json", bins)

            self.assertEqual(looped.returncode, 0, looped.stderr)
            self.assertEqual(json.loads(looped.stdout)["loop_evidence_body_seconds"], 19.0)
            self.assertIn("rerun with --no-condition-on-previous-text", looped.stderr)
            self.assertNotIn("loop", (root / "loop.md").read_text().lower())
            self.assertEqual(recovery.returncode, 0, recovery.stderr)
            self.assertIn("loop evidence remains", recovery.stderr)
            self.assertEqual(clean.returncode, 0, clean.stderr)
            self.assertEqual(json.loads(clean.stdout)["loop_evidence_body_seconds"], 0.0)
            self.assertEqual(clean.stderr, "")

    def test_backend_failure_leaves_no_partial_destinations(self):
        """Would fail if a backend error creates either final output or temp debris."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source = root / "clip.mp4"
            source.write_bytes(b"media")
            markdown, raw = root / "clip.md", root / "clip.json"
            self.make_stub(bins, "ffprobe", "print('12.5')\n")
            self.make_stub(bins, "uvx", "raise SystemExit(17)\n")

            result = self.run_transcribe(source, markdown, raw, bins)

            self.assertNotEqual(result.returncode, 0)
            self.assertFalse(markdown.exists())
            self.assertFalse(raw.exists())
            self.assertEqual(list(root.glob(".clip.*")), [])

    def test_rejects_empty_segments_without_replacing_existing_outputs(self):
        """Would fail if an empty transcript is accepted as source evidence."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source = root / "clip.mp4"
            source.write_bytes(b"media")
            markdown, raw = root / "clip.md", root / "clip.json"
            markdown.write_bytes(b"old markdown")
            raw.write_bytes(b"old json")
            self.make_stub(bins, "ffprobe", "print('12.5')\n")
            self.make_stub(bins, "uvx", textwrap.dedent("""\
                import pathlib, sys
                out = pathlib.Path(sys.argv[sys.argv.index('--output-dir') + 1])
                out.mkdir(parents=True, exist_ok=True)
                (out / 'clip.json').write_text('{"segments": []}')
            """))

            result = self.run_transcribe(source, markdown, raw, bins, "--force")

            self.assertNotEqual(result.returncode, 0)
            self.assertIn("no segments list", result.stderr)
            self.assertEqual(markdown.read_bytes(), b"old markdown")
            self.assertEqual(raw.read_bytes(), b"old json")

    def test_rejects_input_and_output_aliases_before_running_backend(self):
        """Would fail if --force permits source, Markdown, or JSON alias collisions."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source = root / "clip.mp4"
            source.write_bytes(b"media")
            raw = root / "raw.json"
            os.link(source, raw)
            calls = root / "calls"
            self.make_stub(bins, "ffprobe", f"open({str(calls)!r}, 'w').write('called')\nprint('12.5')\n")
            self.make_stub(bins, "uvx", "raise SystemExit(99)\n")

            result = self.run_transcribe(source, root / "clip.md", raw, bins, "--force")

            self.assertNotEqual(result.returncode, 0)
            self.assertIn("aliases input", result.stderr)
            self.assertFalse(calls.exists())

    def test_rejects_markdown_json_alias_before_running_backend(self):
        """Would fail if two transcript representations can overwrite each other."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source, shared = root / "clip.mp4", root / "shared-output"
            source.write_bytes(b"media")
            calls = root / "calls"
            self.make_stub(bins, "ffprobe", f"open({str(calls)!r}, 'w').write('called')\nprint('12.5')\n")
            self.make_stub(bins, "uvx", "raise SystemExit(99)\n")

            result = self.run_transcribe(source, shared, shared, bins, "--force")

            self.assertNotEqual(result.returncode, 0)
            self.assertIn("alias each other", result.stderr)
            self.assertFalse(calls.exists())

    def test_source_mutation_fails_before_any_publication(self):
        """Would fail if media is hashed after ffprobe or backend processing."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source = root / "clip.mp4"
            source.write_bytes(b"original")
            self.make_stub(bins, "ffprobe", "print('12.5')\n")
            self.install_success_backend(bins, b'{"segments":[{"start":0,"end":1,"text":"ok", "tokens": [100],"words":[{"start":0,"end":1,"word":"ok"}]}]}', mutation=source)

            result = self.run_transcribe(source, root / "clip.md", root / "clip.json", bins)

            self.assertNotEqual(result.returncode, 0)
            self.assertIn("source changed", result.stderr)
            self.assertFalse((root / "clip.md").exists())
            self.assertFalse((root / "clip.json").exists())

    def test_rejects_invalid_duration_segments_and_word_timestamps(self):
        """Would fail if malformed ASR timing evidence is committed as a transcript."""
        cases = {
            "non-finite duration": ("nan", {"segments": [{"start": 0, "end": 1, "text": "ok", "tokens": [100], "words": [{"start": 0, "end": 1, "word": "ok"}]}]}),
            "empty segment": ("12.5", {"segments": [{"start": 0, "end": 1, "text": "", "words": [{"start": 0, "end": 1, "word": "ok"}]}]}),
            "whitespace segment": ("12.5", {"segments": [{"start": 0, "end": 1, "text": " ", "tokens": [], "words": []}]}),
            "empty segment missing tokens": ("12.5", {"segments": [{"start": 0, "end": 1, "text": "", "words": []}]}),
            "empty segment missing words": ("12.5", {"segments": [{"start": 0, "end": 1, "text": "", "tokens": []}]}),
            "empty segment with tokens": ("12.5", {"segments": [{"start": 0, "end": 1, "text": "", "tokens": [50364], "words": []}]}),
            "empty segment with words": ("12.5", {"segments": [{"start": 0, "end": 1, "text": "", "tokens": [], "words": [{"start": 0, "end": 1, "word": "ok"}]}]}),
            "reversed segment": ("12.5", {"segments": [{"start": 2, "end": 1, "text": "ok", "tokens": [100], "words": [{"start": 1, "end": 2, "word": "ok"}]}]}),
            "reversed cleared segment": ("12.5", {"segments": [{"start": 2, "end": 1, "text": "", "tokens": [], "words": []}]}),
            "out of duration": ("12.5", {"segments": [{"start": 0, "end": 13, "text": "ok", "tokens": [100], "words": [{"start": 0, "end": 1, "word": "ok"}]}]}),
            "cleared segment out of duration": ("12.5", {"segments": [{"start": 13, "end": 13, "text": "", "tokens": [], "words": []}]}),
            "invalid segment object": ("12.5", {"segments": [None]}),
            "non-string segment text": ("12.5", {"segments": [{"start": 0, "end": 1, "text": 42, "words": []}]}),
            "negative segment": ("12.5", {"segments": [{"start": -1, "end": 1, "text": "ok", "tokens": [100], "words": [{"start": 0, "end": 1, "word": "ok"}]}]}),
            "negative cleared segment": ("12.5", {"segments": [{"start": -1, "end": 0, "text": "", "tokens": [], "words": []}]}),
            "non-finite segment": ("12.5", {"segments": [{"start": float("nan"), "end": 1, "text": "ok", "tokens": [100], "words": [{"start": 0, "end": 1, "word": "ok"}]}]}),
            "non-finite cleared segment": ("12.5", {"segments": [{"start": 0, "end": float("inf"), "text": "", "tokens": [], "words": []}]}),
            "absent words": ("12.5", {"segments": [{"start": 0, "end": 1, "text": "ok", "tokens": [100]}]}),
            "words is not a list": ("12.5", {"segments": [{"start": 0, "end": 1, "text": "ok", "tokens": [100], "words": None}]}),
            "word out of duration": ("12.5", {"segments": [{"start": 0, "end": 1, "text": "ok", "tokens": [100], "words": [{"start": 0, "end": 13, "word": "ok"}]}]}),
            "within segment word overlap": ("12.5", {"segments": [{"start": 0, "end": 2, "text": "one two", "tokens": [100], "words": [{"start": 0, "end": 1.1, "word": "one"}, {"start": 1, "end": 2, "word": "two"}]}]}),
            "within segment word regression": ("12.5", {"segments": [{"start": 0, "end": 2, "text": "one two", "tokens": [100], "words": [{"start": 1, "end": 2, "word": "one"}, {"start": 0, "end": 1, "word": "two"}]}]}),
            "negative word": ("12.5", {"segments": [{"start": 0, "end": 1, "text": "ok", "tokens": [100], "words": [{"start": -1, "end": 1, "word": "ok"}]}]}),
            "reversed word": ("12.5", {"segments": [{"start": 0, "end": 1, "text": "ok", "tokens": [100], "words": [{"start": 1, "end": 0, "word": "ok"}]}]}),
            "non-finite word start": ("12.5", {"segments": [{"start": 0, "end": 1, "text": "ok", "tokens": [100], "words": [{"start": float("nan"), "end": 1, "word": "ok"}]}]}),
            "non-finite word end": ("12.5", {"segments": [{"start": 0, "end": 1, "text": "ok", "tokens": [100], "words": [{"start": 0, "end": float("inf"), "word": "ok"}]}]}),
            "invalid word object": ("12.5", {"segments": [{"start": 0, "end": 1, "text": "ok", "tokens": [100], "words": [None]}]}),
            "non-string word": ("12.5", {"segments": [{"start": 0, "end": 1, "text": "ok", "tokens": [100], "words": [{"start": 0, "end": 1, "word": 42}]}]}),
            "whitespace word": ("12.5", {"segments": [{"start": 0, "end": 1, "text": "ok", "tokens": [100], "words": [{"start": 0, "end": 1, "word": " "}]}]}),
            "empty word": ("12.5", {"segments": [{"start": 0, "end": 1, "text": "ok", "tokens": [100], "words": [{"start": 0, "end": 1, "word": ""}]}]}),
        }
        for name, (duration, payload) in cases.items():
            with self.subTest(name=name), tempfile.TemporaryDirectory() as temp:
                root = pathlib.Path(temp)
                bins = root / "bin"
                bins.mkdir()
                source = root / "clip.mp4"
                source.write_bytes(b"media")
                self.make_stub(bins, "ffprobe", f"print({duration!r})\n")
                self.install_success_backend(bins, json.dumps(payload).encode())
                result = self.run_transcribe(source, root / "clip.md", root / "clip.json", bins)
                self.assertNotEqual(result.returncode, 0)
                self.assertFalse((root / "clip.md").exists())
                self.assertFalse((root / "clip.json").exists())

    def test_preserves_backend_emission_order_and_sorts_markdown_union_bounds(self):
        """Catches global-order rejection, raw reordering, wrong sort keys or counts."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source = root / "clip.mp4"
            source.write_bytes(b"media")
            self.make_stub(bins, "ffprobe", "print('1800')\n")
            # Fixture records 526 through 529 reproduce the cleared topology.
            fixture = {"segments": [
                {"id": 526, "seek": 172960, "start": 1757.8, "end": 1757.8,
                 "text": "", "tokens": [], "words": []},
                {"id": 527, "seek": 172960, "start": 1757.8, "end": 1757.8,
                 "text": "", "tokens": [], "words": []},
                {"id": 528, "seek": 172960, "start": 1754.6, "end": 1754.6,
                 "text": "", "tokens": [], "words": []},
                {"id": 529, "seek": 175780, "start": 1757.8, "end": 1758.5,
                 "text": " Save.", "tokens": [50365, 15541, 13, 50415], "words": [
                     {"word": " Save.", "start": 1757.8, "end": 1758.5,
                      "probability": 7.152557373046875e-7}]},
                {"start": 1756, "end": 1758, "text": " zeta\u2014first tie", "tokens": [100], "words": [
                    {"start": 1755.8, "end": 1758.2, "word": " zeta\u2014first tie"}]},
                {"start": 1756, "end": 1758, "text": " alpha second tie", "tokens": [100], "words": [
                    {"start": 1755.8, "end": 1758.2, "word": " alpha second tie"}]},
                {"start": 1756.2, "end": 1757, "text": " shorter union", "tokens": [100], "words": [
                    {"start": 1755.8, "end": 1757, "word": " shorter union"}]},
                {"start": 1757, "end": 1759, "text": " earliest union", "tokens": [100], "words": [
                    {"start": 1755.6, "end": 1759, "word": " earliest union"}]},
            ]}
            self.install_success_backend(bins, json.dumps(fixture).encode())

            result = self.run_transcribe(source, root / "clip.md", root / "clip.json", bins)

            self.assertEqual(result.returncode, 0, result.stderr)
            raw = (root / "clip.json").read_bytes()
            self.assertEqual(raw, json.dumps(fixture, ensure_ascii=True, separators=(",", ":")).encode())
            self.assertEqual(json.loads(raw), fixture)
            markdown = (root / "clip.md").read_text()
            self.assertEqual([line for line in markdown.splitlines() if line.startswith("[")], [
                "[29:15.600 - 29:19.000] earliest union",
                "[29:15.800 - 29:17.000] shorter union",
                "[29:15.800 - 29:18.200] zeta-first tie",
                "[29:15.800 - 29:18.200] alpha second tie",
                "[29:17.800 - 29:18.500] Save.",
            ])
            completion = json.loads(result.stdout)
            for field, count in {
                "backend_segment_count": 8,
                "rendered_segment_count": 5,
                "cleared_segment_count": 3,
                "unaligned_segment_count": 0,
                "emission_order_regressions": 2,
                "emission_overlap_count": 4,
            }.items():
                self.assertEqual(completion[field], count)
                self.assertIn(f"- {field}: `{count}`\n", markdown)
            self.assertIn("Raw JSON order: original backend emission order.", markdown)
            self.assertIn("Markdown order: chronologically sorted by union start, union end, then original backend index.", markdown)
            self.assertEqual(completion["raw_json_order"], "backend_emission")
            self.assertEqual(completion["markdown_order"], "union_start_union_end_original_index")

    def test_accepts_independent_cross_segment_word_alignment(self):
        """Catches global word-order rejection even when raw segments are disjoint."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source = root / "clip.mp4"
            source.write_bytes(b"media")
            self.make_stub(bins, "ffprobe", "print('12.5')\n")
            fixture = {"segments": [
                {"start": 0, "end": 1, "text": "one", "tokens": [100], "words": [
                    {"start": 0, "end": 1.1, "word": "one"}]},
                {"start": 1.1, "end": 2, "text": "two", "tokens": [100], "words": [
                    {"start": 1, "end": 1.5, "word": "two"}]},
            ]}
            self.install_success_backend(bins, json.dumps(fixture).encode())

            result = self.run_transcribe(source, root / "clip.md", root / "clip.json", bins)

            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertEqual(json.loads((root / "clip.json").read_bytes()), fixture)
            self.assertTrue((root / "clip.md").read_text().endswith(
                "[00:00.000 - 00:01.100] one\n[00:01.000 - 00:02.000] two\n"))
            completion = json.loads(result.stdout)
            self.assertEqual(completion["emission_order_regressions"], 0)
            self.assertEqual(completion["emission_overlap_count"], 0)

    def test_preserves_exact_unaligned_record_and_renders_segment_timing(self):
        """Catches rejecting or omitting backend text whose word alignment is empty."""
