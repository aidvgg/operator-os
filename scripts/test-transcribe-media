    def test_preserves_and_skips_exact_canonical_cleared_segment(self):
        """Would fail if MLX's canonical cleared record is rejected or rendered."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source = root / "clip.mp4"
            source.write_bytes(b"media")
            self.make_stub(bins, "ffprobe", "print('300')\n")
            cleared = {
                "id": 57,
                "seek": 24352,
                "start": 243.52,
                "end": 243.52,
                "text": "",
                "tokens": [],
                "words": [],
            }
            fixture = {
                "segments": [
                    {"start": 242.9, "end": 243.3, "text": " before", "tokens": [100], "words": [
                        {"start": 242.9, "end": 243.3, "word": " before"},
                    ]},
                    cleared,
                    {"start": 243.52, "end": 244.0, "text": " after", "tokens": [100], "words": [
                        {"start": 243.4, "end": 244.0, "word": " after"},
                    ]},
                ]
            }
            fixture_bytes = json.dumps(fixture).encode()
            self.install_success_backend(bins, fixture_bytes)

            result = self.run_transcribe(source, root / "clip.md", root / "clip.json", bins)

            self.assertEqual(result.returncode, 0, result.stderr)
            expected_raw = json.dumps(fixture, ensure_ascii=True, separators=(",", ":")).encode()
            self.assertEqual((root / "clip.json").read_bytes(), expected_raw)
            self.assertEqual(json.loads(expected_raw)["segments"][1], cleared)
            segment_lines = [
                line for line in (root / "clip.md").read_text().splitlines()
                if line.startswith("[")
            ]
            self.assertEqual(segment_lines, [
                "[04:02.900 - 04:03.300] before",
                "[04:03.400 - 04:04.000] after",
            ])

    def test_second_destination_failure_rolls_back_forced_replacements(self):
        """Would fail if JSON is published when Markdown replacement later fails."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source = root / "clip.mp4"
            source.write_bytes(b"media")
            markdown, raw = root / "clip.md", root / "clip.json"
            markdown.write_bytes(b"old markdown")
            raw.write_bytes(b"old raw")
            self.make_stub(bins, "ffprobe", "print('12.5')\n")
            self.install_success_backend(bins, b'{"segments":[{"start":0,"end":1,"text":"ok", "tokens": [100],"words":[{"start":0,"end":1,"word":"ok"}]}]}')
            loader = importlib.machinery.SourceFileLoader("transcribe_media_test", str(SCRIPT))
            spec = importlib.util.spec_from_loader(loader.name, loader)
            module = importlib.util.module_from_spec(spec)
            loader.exec_module(module)
            original_replace = module.os.replace

            def fail_markdown_replace(source_path, destination_path):
                if pathlib.Path(destination_path) == markdown:
                    raise OSError("injected second destination failure")
                return original_replace(source_path, destination_path)

            env = os.environ.copy()
            env["PATH"] = str(bins) + os.pathsep + env["PATH"]
            argv = [str(SCRIPT), str(source), "--output", str(markdown), "--json-output", str(raw), "--source-label", "clip.mp4", "--force"]
            with mock.patch.dict(os.environ, env, clear=True), mock.patch("sys.argv", argv), mock.patch.object(module.os, "replace", side_effect=fail_markdown_replace):
                with self.assertRaises(OSError):
                    module.main()

            self.assertEqual(markdown.read_bytes(), b"old markdown")
            self.assertEqual(raw.read_bytes(), b"old raw")

    def test_second_stage_failure_cleans_first_staged_file(self):
        """Would fail if JSON staging leaves Markdown temp debris after a stage error."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source = root / "clip.mp4"
            source.write_bytes(b"media")
            markdown, raw = root / "clip.md", root / "clip.json"
            self.make_stub(bins, "ffprobe", "print('12.5')\n")
            self.install_success_backend(bins, b'{"segments":[{"start":0,"end":1,"text":"ok", "tokens": [100],"words":[{"start":0,"end":1,"word":"ok"}]}]}')
            loader = importlib.machinery.SourceFileLoader("transcribe_media_stage_test", str(SCRIPT))
            spec = importlib.util.spec_from_loader(loader.name, loader)
            module = importlib.util.module_from_spec(spec)
            loader.exec_module(module)
            original_stage = module.stage
            calls = 0

            def fail_second_stage(destination, body):
                nonlocal calls
                calls += 1
                if calls == 2:
                    raise OSError("injected second stage failure")
                return original_stage(destination, body)

            env = os.environ.copy()
            env["PATH"] = str(bins) + os.pathsep + env["PATH"]
            argv = [str(SCRIPT), str(source), "--output", str(markdown), "--json-output", str(raw), "--source-label", "clip.mp4"]
            with mock.patch.dict(os.environ, env, clear=True), mock.patch("sys.argv", argv), mock.patch.object(module, "stage", side_effect=fail_second_stage):
                with self.assertRaises(OSError):
                    module.main()

            self.assertFalse(markdown.exists())
            self.assertFalse(raw.exists())
            self.assertEqual(list(root.glob(".clip.*")), [])

    def test_normalizes_unicode_dashes_in_persisted_source_label(self):
        """Would fail if transcript labels retain Pd or U+2212 characters."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source = root / "clip.mp4"
            source.write_bytes(b"media")
            self.make_stub(bins, "ffprobe", "print('12.5')\n")
            self.install_success_backend(bins, b'{"segments":[{"start":0,"end":1,"text":"ok", "tokens": [100],"words":[{"start":0,"end":1,"word":"ok"}]}]}')

            result = self.run_transcribe(source, root / "clip.md", root / "clip.json", bins, label="clip\uFE58\uFF0D\u2212.mp4")

            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertTrue((root / "clip.md").read_bytes().startswith(b"# Transcript: clip---.mp4\n"))
            self.assertEqual(json.loads(result.stdout)["source_label"], "clip---.mp4")


