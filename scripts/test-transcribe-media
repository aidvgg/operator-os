    def test_preserves_nonfinite_backend_diagnostics_with_explicit_provenance(self):
        """Catches lossy NaN conversion, nonrecursive counts, or undisclosed extensions."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source = root / "clip.mp4"
            source.write_bytes(b"media")
            self.make_stub(bins, "ffprobe", "print('2542.241655')\n")
            fixture = {
                # Fixture segment 1988 retains its NaN diagnostic value.
                "segments": [{
                    "id": 1988, "seek": 251582, "start": 2524.18, "end": 2525.46,
                    "text": " Save.", "tokens": [50415, 15541, 13, 50415],
                    "temperature": 0.0, "avg_logprob": float("nan"),
                    "compression_ratio": 4.7368421052631575,
                    "no_speech_prob": 3.7178850276209374e-11,
                    "words": [{"word": " Save.", "start": 2524.18, "end": 2525.46,
                               "probability": 0.97900390625}],
                }],
                # Synthetic nested diagnostics exercise both recursive container paths.
                "diagnostics": {"nested": [float("inf"), {"value": -float("inf")}],
                                "finite": 0.0, "missing": None},
            }
            self.install_success_backend(bins, json.dumps(fixture).encode())

            result = self.run_transcribe(source, root / "clip.md", root / "clip.json", bins)

            self.assertEqual(result.returncode, 0, result.stderr)
            raw = (root / "clip.json").read_bytes()
            self.assertEqual(raw, json.dumps(fixture, ensure_ascii=True, allow_nan=True,
                                            separators=(",", ":")).encode())
            self.assertTrue(raw.isascii())
            decoded = json.loads(raw)
            self.assertTrue(math.isnan(decoded["segments"][0]["avg_logprob"]))
            self.assertEqual(decoded["diagnostics"]["nested"], [float("inf"), {"value": -float("inf")}])
            markdown = (root / "clip.md").read_text()
            self.assertIn("- backend_nonfinite_diagnostic_count: `3`\n", markdown)
            self.assertIn("- Backend JSON numeric extensions: Python/MLX nonfinite numeric extensions preserved; not strict RFC JSON.\n", markdown)
            self.assertTrue(markdown.endswith("[42:04.180 - 42:05.460] Save.\n"))
            self.assertEqual(json.loads(result.stdout)["backend_nonfinite_diagnostic_count"], 3)

    def test_rejects_nonempty_segments_without_token_evidence(self):
        """Catches accepting aligned or unaligned text with absent or empty tokens."""
        token_fields = [{}, {"tokens": []}, {"tokens": None}, {"tokens": "token"}]
        for fields in token_fields:
            for words in ([], [{"start": 0, "end": 1, "word": "ok"}]):
                with self.subTest(tokens=fields, words=words), tempfile.TemporaryDirectory() as temp:
                    root = pathlib.Path(temp)
                    bins = root / "bin"
                    bins.mkdir()
                    source = root / "clip.mp4"
                    source.write_bytes(b"media")
                    self.make_stub(bins, "ffprobe", "print('12.5')\n")
                    fixture = {"segments": [{"start": 0, "end": 1, "text": "ok",
                                             "words": words, **fields}]}
                    self.install_success_backend(bins, json.dumps(fixture).encode())

                    result = self.run_transcribe(source, root / "clip.md", root / "clip.json", bins)

                    self.assertNotEqual(result.returncode, 0)
                    self.assertFalse((root / "clip.md").exists())
                    self.assertFalse((root / "clip.json").exists())

    def test_preserves_exact_reversed_backend_records_as_unrenderable_text(self):
        """Catches dropped source text, fabricated timing, or incorrect anomaly counts."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source = root / "clip.mp4"
            source.write_bytes(b"media")
            self.make_stub(bins, "ffprobe", "print('2247.633333')\n")
            # Exact Launch records 1268 through 1272, in original backend order.
            fixture = {"segments": [
                {"id": 1268, "seek": 223488, "start": 2239.98, "end": 2239.98,
                 "text": "", "tokens": [], "temperature": 0.0, "avg_logprob": float("nan"),
                 "compression_ratio": 4.706896551724138,
                 "no_speech_prob": 4.280576934578839e-11, "words": []},
                {"id": 1269, "seek": 223488, "start": 2239.98, "end": 2241.98,
                 "text": "!", "tokens": [50620, 0, 50720], "temperature": 0.0,
                 "avg_logprob": float("nan"), "compression_ratio": 4.706896551724138,
                 "no_speech_prob": 4.280576934578839e-11, "words": []},
                {"id": 1270, "seek": 223488, "start": 2241.98, "end": 2239.98,
                 "text": "!", "tokens": [50720, 0, 50620], "temperature": 0.0,
                 "avg_logprob": float("nan"), "compression_ratio": 4.706896551724138,
                 "no_speech_prob": 4.280576934578839e-11, "words": []},
                {"id": 1271, "seek": 223488, "start": 2239.98, "end": 2241.98,
                 "text": "!", "tokens": [50620, 0, 50720], "temperature": 0.0,
                 "avg_logprob": float("nan"), "compression_ratio": 4.706896551724138,
                 "no_speech_prob": 4.280576934578839e-11, "words": []},
                {"id": 1272, "seek": 223488, "start": 2241.98, "end": 2239.98,
                 "text": "!", "tokens": [50720, 0, 50620], "temperature": 0.0,
                 "avg_logprob": float("nan"), "compression_ratio": 4.706896551724138,
                 "no_speech_prob": 4.280576934578839e-11, "words": []},
            ]}
            self.install_success_backend(bins, json.dumps(fixture).encode())

            result = self.run_transcribe(source, root / "clip.md", root / "clip.json", bins)

            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertEqual((root / "clip.json").read_bytes(),
                             json.dumps(fixture, ensure_ascii=True, allow_nan=True,
                                        separators=(",", ":")).encode())
            markdown = (root / "clip.md").read_text()
            self.assertEqual([line for line in markdown.splitlines() if line.startswith("[")], [
                "[37:19.980 - 37:21.980] !",
                "[37:19.980 - 37:21.980] !",
            ])
            self.assertTrue(markdown.endswith(
                "\n## Unrenderable backend segments\n\n"
                "These records have reversed backend timing. No timestamp was fabricated. Backend indices are zero-based.\n\n"
                "- Backend index `2`; start seconds `2241.98`; end seconds `2239.98`: !\n"
                "- Backend index `4`; start seconds `2241.98`; end seconds `2239.98`: !\n"
            ))
            completion = json.loads(result.stdout)
            for field, count in {
                "backend_segment_count": 5,
                "rendered_segment_count": 2,
                "cleared_segment_count": 1,
                "unaligned_segment_count": 2,
                "reversed_timing_segment_count": 2,
                "emission_order_regressions": 1,
                "emission_overlap_count": 0,
                "backend_nonfinite_diagnostic_count": 5,
            }.items():
                self.assertEqual(completion[field], count)
                self.assertIn(f"- {field}: `{count}`\n", markdown)

    def test_preserves_anomaly_only_result_without_fabricating_rendered_rows(self):
        """Catches dropping all source text when every usable record has reversed timing."""
        with tempfile.TemporaryDirectory() as temp:
            root = pathlib.Path(temp)
            bins = root / "bin"
            bins.mkdir()
            source = root / "clip.mp4"
            source.write_bytes(b"media")
            self.make_stub(bins, "ffprobe", "print('12.5')\n")
            fixture = {"segments": [{"start": 2, "end": 1, "text": " text\u2014kept",
                                     "tokens": [100], "words": []}]}
            self.install_success_backend(bins, json.dumps(fixture).encode())

            result = self.run_transcribe(source, root / "clip.md", root / "clip.json", bins)

            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertEqual(json.loads((root / "clip.json").read_bytes()), fixture)
            markdown = (root / "clip.md").read_text()
            self.assertFalse(any(line.startswith("[") for line in markdown.splitlines()))
            self.assertIn("- Backend index `0`; start seconds `2`; end seconds `1`: text-kept\n", markdown)
            completion = json.loads(result.stdout)
            self.assertEqual(completion["rendered_segment_count"], 0)
            self.assertEqual(completion["unaligned_segment_count"], 0)
            self.assertEqual(completion["reversed_timing_segment_count"], 1)

    def test_rejects_unsupported_reversed_segment_states(self):
        """Catches reversed timing bypassing endpoint, text, token, or word validation."""
        variants = {
            "negative start and end": {"start": -1, "end": -2},
            "negative end": {"end": -1},
            "out of duration start": {"start": 13},
            "nonfinite start": {"start": float("nan")},
            "nonfinite end": {"end": -float("inf")},
            "empty text": {"text": ""},
            "whitespace text": {"text": " "},
            "non-string text": {"text": None},
            "missing tokens": {"tokens": None},
            "empty tokens": {"tokens": []},
            "non-list tokens": {"tokens": "token"},
            "words present": {"words": [{"start": 1, "end": 2, "word": "!"}]},
            "missing words": {"words": None},
        }
        for name, changes in variants.items():
            with self.subTest(name=name), tempfile.TemporaryDirectory() as temp:
                root = pathlib.Path(temp)
                bins = root / "bin"
                bins.mkdir()
                source = root / "clip.mp4"
                source.write_bytes(b"media")
                self.make_stub(bins, "ffprobe", "print('12.5')\n")
                segment = {"start": 2, "end": 1, "text": "!", "tokens": [100], "words": []}
                segment.update(changes)
                for field in ("tokens", "words"):
                    if changes.get(field, "present") is None:
                        segment.pop(field)
                self.install_success_backend(bins, json.dumps({"segments": [segment]}).encode())

                result = self.run_transcribe(source, root / "clip.md", root / "clip.json", bins)

                self.assertNotEqual(result.returncode, 0)
                self.assertFalse((root / "clip.md").exists())
                self.assertFalse((root / "clip.json").exists())

    def test_rejects_result_with_only_canonical_cleared_segments(self):
