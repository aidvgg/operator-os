#!/usr/bin/env python3
"""Generate and verify model-specific discovery files from one route registry.

Usage:
  scripts/sync-agent-adapters --write
  scripts/sync-agent-adapters --check
  scripts/sync-agent-adapters --check --staged

The generated files contain routing and discovery only. The shared operating contract stays
in CLAUDE.md for compatibility, and each workflow stays in its canonical SKILL.md. This script
prevents those rules from being copied into provider files that can drift independently.
"""
import argparse
