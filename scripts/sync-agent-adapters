HTML_COMMENT = re.compile(r"<!--.*?-->", re.DOTALL)


class ConfigError(Exception):
    pass


def die(message, code=2):
    print(f"agent-adapters: BROKEN - {message}", file=sys.stderr)
    return code


def safe_rel(value, label):
    if not isinstance(value, str) or not value.strip():
        raise ConfigError(f"{label} must be a non-empty repository-relative path")
    path = PurePosixPath(value)
    if path.is_absolute() or ".." in path.parts or value.startswith("./") or str(path) != value:
        raise ConfigError(f"{label} must be a normalized repository-relative path: {value!r}")
    return value


def ensure_no_symlink(root, rel, label):
    current = root
    for part in PurePosixPath(rel).parts:
        current = current / part
        if current.is_symlink():
            raise ConfigError(f"{label} traverses a symlink: {rel}")


def git_index_mode(root, rel):
    result = subprocess.run(
        ["git", "-C", str(root), "ls-files", "--stage", "--", rel],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise ConfigError(f"git ls-files failed for {rel}: {result.stderr.strip()[:200]}")
    rows = [line for line in result.stdout.splitlines() if line]
    if not rows:
        return None
    if len(rows) != 1:
        raise ConfigError(f"staged path has unresolved index entries: {rel}")
    fields = rows[0].split(None, 3)
    if len(fields) < 4 or fields[2] != "0":
        raise ConfigError(f"staged path has an invalid index entry: {rel}")
    return fields[0]


def git_index_text(root, rel):
    result = subprocess.run(
        ["git", "-C", str(root), "show", ":" + rel],
        capture_output=True,
        text=True,
    )
    if result.returncode == 0:
        return result.stdout
    raise ConfigError(f"git show failed for staged path {rel}: {result.stderr.strip()[:200]}")


def generated_surface_mode(root, rel, staged=False):
    if staged:
        return git_index_mode(root, rel)
    ensure_no_symlink(root, rel, "generated surface")
    path = root / rel
    if not path.is_file():
        return None
    return f"{path.stat().st_mode & 0o777:04o}"


def read_text(root, rel, staged=False):
    if staged:
        mode = git_index_mode(root, rel)
        if mode is None:
            return None
        if mode not in {"100644", "100755"}:
            raise ConfigError(f"staged path must be a regular file, not mode {mode}: {rel}")
        return git_index_text(root, rel)
    ensure_no_symlink(root, rel, "adapter input")
    path = root / rel
    return path.read_text(encoding="utf-8") if path.is_file() else None


def valid_surface_group_path(group, rel):
    if group == "agent_entrypoints":
        return rel in REQUIRED_SURFACE_FLOOR[group]
    if group == "skill_entrypoints":
        return rel in REQUIRED_SURFACE_FLOOR[group]
    if group == "claude_commands":
        return rel in REQUIRED_SURFACE_FLOOR[group]
    if group == "skill_adapters":
        # Open set by shape, unlike the three pinned groups: a new skill is a registry-only
        # edit. The shape is still exact, and the workflow entrypoint paths stay reserved so an
        # adapter can never shadow the daily-log surface that owns mode routing.
        if rel in REQUIRED_SURFACE_FLOOR["skill_entrypoints"]:
            return False
        parts = PurePosixPath(rel).parts
        return (
            len(parts) == 4
            and any(rel.startswith(root) for root in SKILL_ADAPTER_ROOTS)
            and parts[3] == "SKILL.md"
            and bool(re.fullmatch(r"[a-z0-9]+(-[a-z0-9]+)*", parts[2]))
        )
    return False


def load_manifest(root, staged=False):
    raw = read_text(root, MANIFEST_PATH, staged=staged)
    if raw is None:
        return None
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise ConfigError(f"{MANIFEST_PATH} is invalid JSON at line {exc.lineno}: {exc.msg}")
    if not isinstance(data, dict):
        raise ConfigError("manifest top level must be an object")
    if data.get("schema_version") != 1:
        raise ConfigError("schema_version must be 1")
    safe_rel(data.get("canonical_contract"), "canonical_contract")
    if data["canonical_contract"] != "CLAUDE.md":
        raise ConfigError("canonical_contract must remain CLAUDE.md for Claude Code compatibility")
    workflows = data.get("workflows")
    if not isinstance(workflows, list) or not workflows:
        raise ConfigError("workflows must be a non-empty list")
    seen_workflows = set()
    seen_aliases = {}
    for workflow in workflows:
        if not isinstance(workflow, dict):
            raise ConfigError("every workflow must be an object")
        workflow_id = workflow.get("id")
        if not isinstance(workflow_id, str) or not workflow_id:
            raise ConfigError("every workflow needs a non-empty id")
        if workflow_id in seen_workflows:
            raise ConfigError(f"duplicate workflow id: {workflow_id}")
        seen_workflows.add(workflow_id)
        safe_rel(workflow.get("canonical_skill"), f"workflow {workflow_id} canonical_skill")
        modes = workflow.get("modes")
        if not isinstance(modes, list) or not modes:
            raise ConfigError(f"workflow {workflow_id} needs at least one mode")
        seen_modes = set()
        seen_commands = set()
        for mode in modes:
            if not isinstance(mode, dict):
                raise ConfigError(f"workflow {workflow_id} modes must be objects")
            allowed_mode_keys = {
                "id",
                "command",
                "aliases",
                "first_turn_actions",
                "capabilities",
                "fallbacks",
                "platform_exceptions",
            }
            unexpected_mode_keys = sorted(set(mode) - allowed_mode_keys)
            if unexpected_mode_keys:
                raise ConfigError(
                    f"workflow {workflow_id} mode contains unsupported policy fields: "
                    + ", ".join(unexpected_mode_keys)
                )
            mode_id = mode.get("id")
            command = mode.get("command")
            aliases = mode.get("aliases")
            if not isinstance(mode_id, str) or not mode_id or mode_id in seen_modes:
                raise ConfigError(f"workflow {workflow_id} has an invalid or duplicate mode id")
            seen_modes.add(mode_id)
            if not isinstance(command, str) or not command.startswith("/"):
                raise ConfigError(f"workflow {workflow_id} mode {mode_id} needs a slash command")
            if command.casefold() in seen_commands:
                raise ConfigError(f"workflow {workflow_id} repeats slash command {command}")
            seen_commands.add(command.casefold())
            if not isinstance(aliases, list) or not aliases:
                raise ConfigError(f"workflow {workflow_id} mode {mode_id} needs aliases")
            seen_mode_aliases = set()
            for alias in aliases:
                if not isinstance(alias, str) or not alias.strip():
                    raise ConfigError(f"workflow {workflow_id} mode {mode_id} has an empty alias")
                # Aliases are rendered into YAML frontmatter and markdown code spans; a
                # backslash, quote, backtick, or control character would emit a generated
                # skill that every byte-equality check still calls clean while the runtime
                # can no longer parse it. That is the silent un-discovery hazard: the sync
                # check stays green while the workflow quietly stops being discoverable.
                if alias != alias.strip() or not re.fullmatch(r"[A-Za-z0-9 '/-]+", alias):
                    raise ConfigError(
                        f"workflow {workflow_id} mode {mode_id} alias {alias!r} contains "
                        "characters outside letters, digits, space, apostrophe, slash and "
                        "hyphen; widen the charset deliberately here if a new alias truly "
                        "needs more"
                    )
                key = alias.casefold()
                if key in seen_mode_aliases:
                    raise ConfigError(f"workflow {workflow_id} mode {mode_id} repeats alias {alias!r}")
                seen_mode_aliases.add(key)
                prior = seen_aliases.get(key)
                owner = f"{workflow_id}:{mode_id}"
                if prior and prior != owner:
                    raise ConfigError(f"alias {alias!r} belongs to both {prior} and {owner}")
                seen_aliases[key] = owner
            if command.casefold() not in seen_mode_aliases:
                raise ConfigError(f"workflow {workflow_id} mode {mode_id} aliases must include {command}")
            slash_aliases = {alias.casefold() for alias in aliases if alias.startswith("/")}
            if slash_aliases != {command.casefold()}:
                raise ConfigError(
                    f"workflow {workflow_id} mode {mode_id} may declare only its own slash command as a slash alias"
                )
            first_turn = mode.get("first_turn_actions")
            if first_turn is not None:
                if not isinstance(first_turn, list) or not first_turn or not all(
                    isinstance(value, str) and value in FIRST_TURN_ACTION_TEXT for value in first_turn
                ):
                    raise ConfigError(
                        f"workflow {workflow_id} mode {mode_id} first_turn_actions must use known action ids"
                    )
                if len(first_turn) != len(set(first_turn)):
                    raise ConfigError(
                        f"workflow {workflow_id} mode {mode_id} repeats a first-turn action"
                    )
            capabilities = mode.get("capabilities")
            if not isinstance(capabilities, dict) or set(capabilities) != {"required", "optional"}:
                raise ConfigError(f"workflow {workflow_id} mode {mode_id} capabilities must be an object")
            required_capabilities = capabilities.get("required")
            optional_capabilities = capabilities.get("optional")
            if not isinstance(required_capabilities, list) or not all(
                isinstance(value, str) and value in CAPABILITY_IDS for value in required_capabilities
            ) or len(required_capabilities) != len(set(required_capabilities)):
                raise ConfigError(
                    f"workflow {workflow_id} mode {mode_id} required capabilities must use unique known ids"
                )
            if "repository_read" not in required_capabilities:
                raise ConfigError(f"workflow {workflow_id} mode {mode_id} must require repository_read")
            if not isinstance(optional_capabilities, list) or not all(
                isinstance(value, str) and value in CAPABILITY_IDS for value in optional_capabilities
            ) or len(optional_capabilities) != len(set(optional_capabilities)):
                raise ConfigError(
                    f"workflow {workflow_id} mode {mode_id} optional capabilities must use unique known ids"
                )
            if set(required_capabilities) & set(optional_capabilities):
                raise ConfigError(f"workflow {workflow_id} mode {mode_id} repeats required capabilities as optional")
            fallbacks = mode.get("fallbacks")
            if not isinstance(fallbacks, list) or not fallbacks:
                raise ConfigError(f"workflow {workflow_id} mode {mode_id} needs structured capability fallbacks")
            fallback_capabilities = set()
            for fallback in fallbacks:
                if not isinstance(fallback, dict) or set(fallback) != {"capability", "action"}:
                    raise ConfigError(
                        f"workflow {workflow_id} mode {mode_id} fallbacks need only capability and action"
                    )
                capability = fallback.get("capability")
                action = fallback.get("action")
                if capability not in CAPABILITY_IDS or action not in FALLBACK_ACTION_TEXT:
                    raise ConfigError(
                        f"workflow {workflow_id} mode {mode_id} fallback uses an unknown capability or action"
                    )
                if capability in fallback_capabilities:
                    raise ConfigError(
                        f"workflow {workflow_id} mode {mode_id} repeats fallback for {capability}"
                    )
                fallback_capabilities.add(capability)
            if fallback_capabilities != set(optional_capabilities):
                raise ConfigError(
                    f"workflow {workflow_id} mode {mode_id} must declare one fallback per optional capability"
                )
            exceptions = mode.get("platform_exceptions", [])
            if not isinstance(exceptions, list):
                raise ConfigError(f"workflow {workflow_id} mode {mode_id} platform_exceptions must be a list")
            seen_exception_platforms = set()
            for exception in exceptions:
                if not isinstance(exception, dict):
                    raise ConfigError(
                        f"workflow {workflow_id} mode {mode_id} platform exceptions must be objects"
                    )
                platform = exception.get("platform")
                alias = exception.get("alias")
                reason = exception.get("reason")
                if not all(isinstance(value, str) and value for value in (platform, alias, reason)):
                    raise ConfigError(
                        f"workflow {workflow_id} mode {mode_id} platform exceptions need platform, alias, and reason"
                    )
                exception_key = (platform.casefold(), alias.casefold())
                if exception_key in seen_exception_platforms:
                    raise ConfigError(
                        f"workflow {workflow_id} mode {mode_id} repeats a platform exception for {platform}: {alias}"
                    )
                seen_exception_platforms.add(exception_key)
                if alias.casefold() not in {value.casefold() for value in aliases}:
                    raise ConfigError(
                        f"workflow {workflow_id} mode {mode_id} platform exception names undeclared alias {alias!r}"
                    )
    surfaces = data.get("generated_surfaces")
    if not isinstance(surfaces, dict):
        raise ConfigError("generated_surfaces must be an object")
    paths = []
    for group in ("agent_entrypoints", "skill_entrypoints", "claude_commands", "skill_adapters"):
        entries = surfaces.get(group)
        if not isinstance(entries, list) or not entries:
            raise ConfigError(f"generated_surfaces.{group} must be a non-empty list")
        for entry in entries:
            if not isinstance(entry, dict):
                raise ConfigError(f"generated_surfaces.{group} entries must be objects")
            rel = safe_rel(entry.get("path"), f"{group} path")
            if not is_generated_candidate(rel):
                raise ConfigError(f"generated surface path is outside adapter locations: {rel}")
            if not valid_surface_group_path(group, rel):
                raise ConfigError(f"generated surface path is invalid for {group}: {rel}")
            if rel in RESERVED_SURFACES:
                raise ConfigError(f"generated surface is reserved: {rel} ({RESERVED_SURFACES[rel]})")
            paths.append(rel)
            if group in {"agent_entrypoints", "skill_entrypoints"} and not isinstance(
                entry.get("platform"), str
            ):
                raise ConfigError(f"{group} entry {rel} needs a platform")
            expected_platform = REQUIRED_PLATFORM_BY_PATH.get(rel)
            if expected_platform is not None and entry.get("platform") != expected_platform:
                raise ConfigError(f"generated surface platform changed for {rel}: expected {expected_platform!r}")
            if group == "skill_entrypoints" and not isinstance(entry.get("workflow"), str):
                raise ConfigError(f"skill entrypoint {rel} needs a workflow")
            if group == "skill_entrypoints" and entry.get("workflow") != "daily-log":
                raise ConfigError(f"required skill surface must route to daily-log: {rel}")
            if group == "claude_commands" and not isinstance(entry.get("mode"), str):
                raise ConfigError(f"Claude command {rel} needs a mode")
            if group == "claude_commands" and PurePosixPath(rel).stem != entry["mode"]:
                raise ConfigError(f"Claude command path must match its mode: {rel} -> {entry['mode']}")
            if group == "skill_adapters":
                unexpected = sorted(set(entry) - {"path", "skill", "canonical_skill", "tier", "trigger"})
                if unexpected:
                    raise ConfigError(
                        f"skill adapter {rel} contains unsupported fields: " + ", ".join(unexpected)
                    )
                skill_id = entry.get("skill")
                if not isinstance(skill_id, str) or skill_id != PurePosixPath(rel).parts[2]:
                    raise ConfigError(f"skill adapter {rel} must name the skill in its own path")
                # A skill may expose more than one host-specific adapter path.
                canonical = safe_rel(entry.get("canonical_skill"), f"skill adapter {rel} canonical_skill")
                if canonical != f"{SKILL_CANONICAL_ROOT}{skill_id}/SKILL.md":
                    raise ConfigError(
                        f"skill adapter {rel} must point at {SKILL_CANONICAL_ROOT}{skill_id}/SKILL.md"
                    )
                if entry.get("tier") not in SKILL_ADAPTER_TIERS:
                    raise ConfigError(
                        f"skill adapter {rel} tier must be one of " + ", ".join(sorted(SKILL_ADAPTER_TIERS))
                    )
                trigger = entry.get("trigger")
                if not isinstance(trigger, str) or trigger != trigger.strip() or not trigger:
                    raise ConfigError(f"skill adapter {rel} needs a non-empty trimmed trigger")
                if len(trigger) > SKILL_TRIGGER_MAX_CHARS:
                    raise ConfigError(
                        f"skill adapter {rel} trigger is {len(trigger)} characters; the cap is "
                        f"{SKILL_TRIGGER_MAX_CHARS} so the repo's skills stay inside the host's "
                        "initial skill-list budget"
                    )
                if any(character in trigger for character in "\n\r\t"):
                    raise ConfigError(f"skill adapter {rel} trigger must be a single line")
                # CLAUDE.md bans em dashes everywhere, and this string is rendered into a
                # generated file that no human reviews line by line. Written as escapes so this
                # detector is not itself a hit for the repo-wide sweep it exists to enforce:
                # U+2014 is the em dash, U+2013 the en dash.
                if "\u2014" in trigger or "\u2013" in trigger:
                    raise ConfigError(f"skill adapter {rel} trigger contains a dash CLAUDE.md bans")
    if len(paths) != len(set(paths)):
        raise ConfigError("generated surface paths must be unique")
    for group, required_paths in REQUIRED_SURFACE_FLOOR.items():
        declared_paths = {entry["path"] for entry in surfaces[group]}
        missing_paths = sorted(required_paths - declared_paths)
        if missing_paths:
            raise ConfigError(f"generated_surfaces.{group} dropped required surfaces: " + ", ".join(missing_paths))
    declared_platforms = {
        entry["platform"].casefold()
        for group in ("agent_entrypoints", "skill_entrypoints")
        for entry in surfaces[group]
    }
    for workflow in workflows:
        for mode in workflow["modes"]:
            for exception in mode.get("platform_exceptions", []):
                if exception["platform"].casefold() not in declared_platforms:
                    raise ConfigError(
                        f"workflow {workflow['id']} mode {mode['id']} names unknown exception platform "
                        f"{exception['platform']!r}"
                    )
    required = data.get("required_existing")
    if not isinstance(required, list) or not required:
        raise ConfigError("required_existing must be a non-empty list")
    for item in required:
        if not isinstance(item, dict):
            raise ConfigError("required_existing entries must be objects")
        safe_rel(item.get("path"), "required_existing path")
        if not isinstance(item.get("must_contain"), str) or not item["must_contain"]:
            raise ConfigError("every required_existing item needs must_contain")
    declared_required = {item["path"] for item in required}
    if len(declared_required) != len(required):
        raise ConfigError("required_existing paths must be unique")
    missing_required = sorted(set(REQUIRED_EXISTING_POINTERS) - declared_required)
    if missing_required:
        raise ConfigError("required_existing dropped compatibility files: " + ", ".join(missing_required))
    required_by_path = {item["path"]: item for item in required}
    for rel, pointer in REQUIRED_EXISTING_POINTERS.items():
        if required_by_path[rel]["must_contain"] != pointer:
            raise ConfigError(f"required_existing compatibility pointer changed for {rel}: expected {pointer!r}")
    owned_paths = {data["canonical_contract"]}
    owned_paths.update(workflow["canonical_skill"] for workflow in workflows)
    owned_paths.update(item["path"] for item in required)
    collisions = sorted(set(paths) & owned_paths)
    if collisions:
        raise ConfigError("generated surfaces collide with canonical or required files: " + ", ".join(collisions))
    daily = next((workflow for workflow in workflows if workflow["id"] == "daily-log"), None)
    if seen_workflows != {"daily-log"}:
        raise ConfigError("new workflows require an explicit all-platform generator expansion")
    if daily is None or daily["canonical_skill"] != "skills/daily-log/SKILL.md":
        raise ConfigError("daily-log must retain canonical skill skills/daily-log/SKILL.md")
    daily_modes = {mode["id"]: mode for mode in daily["modes"]}
    if set(daily_modes) != set(REQUIRED_MODE_FLOOR):
        raise ConfigError("daily-log modes must match the compatibility floor exactly")
    for mode_id, floor in REQUIRED_MODE_FLOOR.items():
        mode = daily_modes.get(mode_id)
        if mode is None or mode["command"] != floor["command"]:
            raise ConfigError(f"daily-log must retain mode {mode_id} with command {floor['command']}")
        missing_aliases = floor["aliases"] - {alias.casefold() for alias in mode["aliases"]}
        if missing_aliases:
            raise ConfigError(f"daily-log mode {mode_id} dropped compatibility aliases: " + ", ".join(sorted(missing_aliases)))
        actual_fallbacks = tuple(
            (fallback["capability"], fallback["action"]) for fallback in mode["fallbacks"]
        )
        if actual_fallbacks != floor["fallbacks"]:
            raise ConfigError(f"daily-log mode {mode_id} changed its compatibility fallback actions")
        if set(mode["capabilities"]["required"]) != {"repository_read"}:
            raise ConfigError(f"daily-log mode {mode_id} changed its required capability floor")
        expected_optional = {capability for capability, _action in floor["fallbacks"]}
        if set(mode["capabilities"]["optional"]) != expected_optional:
            raise ConfigError(f"daily-log mode {mode_id} changed its optional capability floor")
    plan = daily_modes["plan"]
    if tuple(plan.get("first_turn_actions", ())) != PLAN_FIRST_TURN_ACTION_FLOOR:
        raise ConfigError("daily-log plan changed its compatibility first-turn actions")
    modes_with_unexpected_first_turn = sorted(
        mode_id for mode_id, mode in daily_modes.items()
        if mode_id != "plan" and "first_turn_actions" in mode
    )
    if modes_with_unexpected_first_turn:
        raise ConfigError(
            "daily-log first-turn behavior is plan-only; remove it from: "
            + ", ".join(modes_with_unexpected_first_turn)
        )
    for mode_id, mode in daily_modes.items():
        # Both hosts ship their own built-in /plan. The daily-log plan mode must therefore be
        # reachable by natural language on both, never by the slash command.
        expected_exceptions = (
            [CLAUDE_PLAN_EXCEPTION, CODEX_PLAN_EXCEPTION, CODEX_SKILL_PLAN_EXCEPTION]
            if mode_id == "plan" else []
        )
        if mode.get("platform_exceptions", []) != expected_exceptions:
            raise ConfigError(
                f"daily-log mode {mode_id} changed its compatibility platform exceptions"
            )
    return data


def workflow_map(manifest):
    return {workflow["id"]: workflow for workflow in manifest["workflows"]}


def mode_map(workflow):
    return {mode["id"]: mode for mode in workflow["modes"]}


def available_aliases(mode, platform=None):
    excluded = {
        exception["alias"].casefold()
        for exception in mode.get("platform_exceptions", [])
        if platform is not None and exception["platform"].casefold() == platform.casefold()
    }
    return [alias for alias in mode["aliases"] if alias.casefold() not in excluded]


def aliases_text(workflow, platform=None):
    values = []
    for mode in workflow["modes"]:
        values.extend(available_aliases(mode, platform=platform))
    return "; ".join(values)


def route_block(workflow, platform=None):
    lines = [
        f"### {workflow['id']}",
        "",
        f"Canonical workflow: `{workflow['canonical_skill']}`.",
        "",
    ]
    for mode in workflow["modes"]:
        aliases = ", ".join(f"`{alias}`" for alias in available_aliases(mode, platform=platform))
        lines.extend([f"#### `{mode['command']}`", "", f"Aliases: {aliases}.", ""])
        for exception in mode.get("platform_exceptions", []):
            if platform is not None and exception["platform"].casefold() == platform.casefold():
                lines.extend([f"Platform exception: {exception['reason']}", ""])
        first_turn = mode.get("first_turn_actions")
        if first_turn:
            lines.extend([f"First-turn contract for `{mode['command']}` only:", ""])
            lines.extend(f"- {FIRST_TURN_ACTION_TEXT[action]}" for action in first_turn)
        lines.extend(["", f"Capability fallbacks for `{mode['command']}` only:", ""])
        lines.extend(f"- {FALLBACK_ACTION_TEXT[item['action']]}" for item in mode["fallbacks"])
        lines.append("")
    lines.extend([
        "",
        "On a semantic match, read the canonical workflow before responding and execute only the matched mode. Do not substitute a generic intake checklist or borrow another mode's first-turn behavior.",
    ])
    return lines


def skill_route_lines(manifest):
    """One routing line per skill adapter, so every host sees the whole skill set, not daily-log only."""
    seen = {}
    for entry in manifest["generated_surfaces"]["skill_adapters"]:
        seen.setdefault(entry["skill"], entry)
    lines = []
    for skill_id in sorted(seen):
        entry = seen[skill_id]
        lines.append(
            f"- `{skill_id}` ({entry['tier']}): {entry['trigger']} Canonical file: `{entry['canonical_skill']}`."
        )
    return lines


def render_agent_entrypoint(manifest, platform):
    contract = manifest["canonical_contract"]
    lines = [
        HEADER,
        "# Northwind Labs agent entrypoint",
        "",
        f"Platform surface: {platform}.",
        "",
        f"Read `{contract}` in full before acting. It is the canonical shared operating contract for every model, not a Claude-only file. It keeps the filename `{contract}` so the Claude Code loader still finds it without configuration. Then follow its context routing, precedence, write, safety, and verification rules exactly.",
        "",
        "## Immediate workflow routing",
        "",
        "The aliases and fallbacks below are generated from `ai/AGENT_ROUTES.json`, their single owner.",
        "",
    ]
    for workflow in manifest["workflows"]:
        lines.extend(route_block(workflow, platform=platform))
        lines.append("")
    lines.extend([
        "## Skill discovery",
        "",
        f"Skills hosts discover repository skills under `{SKILL_ADAPTER_ROOTS[0]}` (Codex, invoked as `$<name>` or through `/skills`) and `{SKILL_ADAPTER_ROOTS[1]}` (Claude Code). Each of those files is a generated discovery adapter that names its canonical file under `{SKILL_CANONICAL_ROOT}`, and the canonical file owns the procedure. Read the canonical file in full before running a skill; never execute an adapter's summary as if it were the skill. Claude Code additionally reaches some skills as slash commands under `.claude/commands/`; those command files are thin pointers to the same canonical files.",
        "",
        "Every skill this repository ships, with its trigger and its canonical file:",
        "",
    ])
    lines.extend(skill_route_lines(manifest))
    lines.extend([
        "",
        "## Maintenance",
        "",
        "Do not edit this file directly. Change the owning contract, workflow, or `ai/AGENT_ROUTES.json`, then run `scripts/sync-agent-adapters --write`. `scripts/repo-doctor` blocks stale generated surfaces.",
        "",
    ])
    return "\n".join(lines)


def render_skill_entrypoint(manifest, workflow, platform):
    description = (
        f"Discover and run the canonical {workflow['id']} workflow for {platform}. "
        f"Trigger when the user says: {aliases_text(workflow, platform=platform)}."
    )
    lines = [
        "---",
        f"name: {workflow['id']}",
        # json.dumps is a valid YAML double-quoted scalar, so any character the alias
        # charset floor is ever widened to admit still renders as parseable frontmatter.
        # The old bare f'"{description}"' with a lossy quote-swap could not promise that.
        f"description: {json.dumps(description)}",
        "---",
        "",
        HEADER,
        f"# {workflow['id']} discovery adapter",
        "",
        f"From the repository root, read `ai/AGENT_ROUTES.json` and `{workflow['canonical_skill']}` in full. Determine the matching mode from the registry, then execute the canonical skill exactly.",
        "",
        "This adapter owns no workflow policy. Do not restate, shorten, or improvise the canonical procedure. The routing projection below is generated from structured action ids in the registry.",
        "",
        "## Generated routing projection",
        "",
    ]
    lines.extend(route_block(workflow, platform=platform))
    lines.append("")
    return "\n".join(lines)


SKILL_ADAPTER_TIER_TEXT = {
    "first-party": (
        "First-party skill of this operating system. Its verification gates are mandatory, never "
        "skippable for work that looks quick, and a clean gate is not send authority: nothing "
        "client-facing leaves without the operator's explicit go on that specific artifact."
    ),
    "vendored": (
        "Vendored reference material, not this repository's doctrine. Provenance, licences, and "
        "the deliberate skip list live in `skills/VENDORED.md`. This repository's voice, pricing, "
        "and precedence rules override anything this file models, including the em-dash copy "
        "style several of these files demonstrate, which is banned in every artifact this repo "
        "produces. It carries no `knowledge/` write licence and no send authority."
    ),
}


def render_skill_adapter(entry):
    skill_id = entry["skill"]
    canonical = entry["canonical_skill"]
    lines = [
        "---",
        f"name: {skill_id}",
        # Same reasoning as render_skill_entrypoint: json.dumps is a valid YAML double-quoted
        # scalar, so a trigger stays parseable frontmatter whatever punctuation it carries.
        f"description: {json.dumps(entry['trigger'])}",
        "---",
        "",
        HEADER,
        f"# {skill_id} skill adapter",
        "",
        f"Canonical skill: `{canonical}`. Read that file in full before acting, then follow it exactly.",
        "",
        f"This adapter exists so a runtime that discovers repository skills under `{SKILL_ADAPTER_ROOTS[0]}` "
        f"or `{SKILL_ADAPTER_ROOTS[1]}` can reach a skill whose canonical copy lives in "
        f"`{SKILL_CANONICAL_ROOT}`. It owns no procedure. Do not restate, shorten, or improvise "
        "the canonical steps, and do not treat this summary as the skill.",
        "",
        "Read `CLAUDE.md` before executing. It is the shared operating contract and it outranks "
        "this skill on precedence, voice, pricing policy, and what counts as a sanctioned write. "
        "The canonical skill wins on execution mechanics.",
        "",
        SKILL_ADAPTER_TIER_TEXT[entry["tier"]],
        "",
        "## Maintenance",
        "",
        f"Do not edit this file directly. Change `{canonical}` for procedure or "
        "`ai/AGENT_ROUTES.json` for routing, then run `scripts/sync-agent-adapters --write`. "
        "`scripts/repo-doctor` blocks stale generated surfaces.",
        "",
    ]
    return "\n".join(lines)


def render_claude_command(workflow, mode):
    lines = [
        "---",
        f"description: Run the canonical daily-log {mode['command']} mode from live repository state.",
        "---",
        HEADER,
        f"Run `{mode['command']}` for: $ARGUMENTS",
        "",
        f"Read `ai/AGENT_ROUTES.json` and `{workflow['canonical_skill']}` in full, then execute the `{mode['id']}` mode exactly. The registry owns aliases and that mode's capability fallbacks; the skill owns procedure and write permissions. Do not substitute a generic intake checklist.",
        "",
        "Generated capability fallbacks for this mode:",
        "",
    ]
    lines.extend(f"- {FALLBACK_ACTION_TEXT[item['action']]}" for item in mode["fallbacks"])
    lines.append("")
    return "\n".join(lines)


def render_surfaces(manifest):
    outputs = {}
    workflows = workflow_map(manifest)
    surfaces = manifest["generated_surfaces"]
    for entry in surfaces["agent_entrypoints"]:
        outputs[entry["path"]] = render_agent_entrypoint(manifest, entry["platform"])
    for entry in surfaces["skill_entrypoints"]:
        workflow = workflows.get(entry.get("workflow"))
        if workflow is None:
            raise ConfigError(f"skill surface {entry['path']} names unknown workflow {entry.get('workflow')!r}")
        outputs[entry["path"]] = render_skill_entrypoint(manifest, workflow, entry["platform"])
    daily = workflows.get("daily-log")
    if daily is None:
        raise ConfigError("claude_commands require the daily-log workflow")
    daily_modes = mode_map(daily)
    for entry in surfaces["claude_commands"]:
        mode = daily_modes.get(entry.get("mode"))
        if mode is None:
            raise ConfigError(f"Claude command {entry['path']} names unknown daily-log mode {entry.get('mode')!r}")
        outputs[entry["path"]] = render_claude_command(daily, mode)
    for entry in surfaces["skill_adapters"]:
        outputs[entry["path"]] = render_skill_adapter(entry)
    return outputs


def selfcheck(manifest, outputs):
    failures = []
    contract = manifest["canonical_contract"]
    workflows = workflow_map(manifest)
    skill_entries = {
        entry["path"]: entry for entry in manifest["generated_surfaces"]["skill_entrypoints"]
    }
    agent_entries = {
        entry["path"]: entry for entry in manifest["generated_surfaces"]["agent_entrypoints"]
    }
    claude_entries = {
        entry["path"]: entry for entry in manifest["generated_surfaces"]["claude_commands"]
    }
    adapter_entries = {
        entry["path"]: entry for entry in manifest["generated_surfaces"]["skill_adapters"]
    }
    for rel, body in outputs.items():
        if HEADER not in body:
            failures.append(f"{rel} lacks generated header")
        if rel in skill_entries:
            entry = skill_entries[rel]
            workflow = workflows.get(entry["workflow"])
            if workflow is None or workflow["canonical_skill"] not in body:
                failures.append(f"{rel} lacks its canonical skill pointer")
            elif any(
                alias not in body
                for mode in workflow["modes"]
                for alias in available_aliases(mode, platform=entry["platform"])
            ):
                failures.append(f"{rel} lacks one or more platform-available aliases")
            if workflow is not None and any(
                FIRST_TURN_ACTION_TEXT[action] not in body
                for mode in workflow["modes"]
                for action in mode.get("first_turn_actions", [])
            ):
                failures.append(f"{rel} lacks one or more structured first-turn actions")
            if workflow is not None and any(
                FALLBACK_ACTION_TEXT[item["action"]] not in body
                for mode in workflow["modes"]
                for item in mode["fallbacks"]
            ):
                failures.append(f"{rel} lacks one or more structured capability fallbacks")
            for mode in workflow["modes"]:
                for exception in mode.get("platform_exceptions", []):
                    if exception["platform"].casefold() == entry["platform"].casefold() \
                            and exception["reason"] not in body:
                        failures.append(f"{rel} lacks platform exception for {exception['alias']}")
        elif rel in agent_entries:
            entry = agent_entries[rel]
            if contract not in body:
                failures.append(f"{rel} lacks canonical contract pointer")
            missing_skills = [
                entry["skill"] for entry in adapter_entries.values()
                if entry["canonical_skill"] not in body
            ]
            if missing_skills:
                failures.append(f"{rel} does not route every skill: " + ", ".join(sorted(set(missing_skills))))
            for workflow in manifest["workflows"]:
                for mode in workflow["modes"]:
                    if any(
                        alias not in body
                        for alias in available_aliases(mode, platform=entry["platform"])
                    ):
                        failures.append(f"{rel} lacks one or more {workflow['id']} aliases")
                        break
                    if any(
                        FIRST_TURN_ACTION_TEXT[action] not in body
                        for action in mode.get("first_turn_actions", [])
                    ) or any(
                        FALLBACK_ACTION_TEXT[item["action"]] not in body
                        for item in mode["fallbacks"]
                    ):
                        failures.append(f"{rel} lacks one or more structured policy actions")
                        break
        elif rel in claude_entries:
            mode = mode_map(workflows["daily-log"])[claude_entries[rel]["mode"]]
            if any(FALLBACK_ACTION_TEXT[item["action"]] not in body for item in mode["fallbacks"]):
                failures.append(f"{rel} lacks its structured capability fallbacks")
        elif rel in adapter_entries:
            entry = adapter_entries[rel]
            if not body.startswith(f"---\nname: {entry['skill']}\n"):
                failures.append(f"{rel} lacks its own skill name in frontmatter")
            if json.dumps(entry["trigger"]) not in body:
                failures.append(f"{rel} lacks its registry trigger")
            if entry["canonical_skill"] not in body:
                failures.append(f"{rel} lacks its canonical skill pointer")
            if contract not in body:
                failures.append(f"{rel} lacks canonical contract pointer")
            if SKILL_ADAPTER_TIER_TEXT[entry["tier"]] not in body:
                failures.append(f"{rel} lacks its tier guardrail")
    if len(outputs) != len(set(outputs)):
        failures.append("rendered output paths are not unique")
    return failures


def is_generated_candidate(rel):
    return rel in {"AGENTS.md", "GEMINI.md", ".github/copilot-instructions.md"} or rel.startswith(
        (".agents/skills/", ".claude/skills/", ".claude/commands/")
    )


def generated_orphans(root, expected, staged=False):
    found = set()
    if staged:
        result = subprocess.run(
            ["git", "-C", str(root), "ls-files", "-z"],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            raise ConfigError(f"git ls-files failed while checking generated orphans: {result.stderr.strip()[:200]}")
        for rel in (item for item in result.stdout.split("\0") if item and is_generated_candidate(item)):
            mode = git_index_mode(root, rel)
            if mode not in {"100644", "100755"}:
                raise ConfigError(f"adapter scan path is staged non-regular file: {rel} (mode {mode})")
            body = git_index_text(root, rel)
            if body is not None and HEADER in body:
                found.add(rel)
        return sorted(found - set(expected))
    for rel in SCAN_PATHS:
        path = root / rel
        if path.is_symlink():
            raise ConfigError(f"adapter scan path is a symlink: {rel}")
        candidates = [path] if path.is_file() else path.rglob("*") if path.is_dir() else []
        for candidate in candidates:
            if candidate.is_symlink():
                raise ConfigError(f"adapter scan path traverses a symlink: {candidate.relative_to(root)}")
            if not candidate.is_file():
                continue
            try:
                body = candidate.read_text(encoding="utf-8")
            except UnicodeDecodeError:
                continue
            except OSError as exc:
                raise ConfigError(f"could not inspect generated candidate {candidate.relative_to(root)}: {exc}")
            if HEADER in body:
                found.add(str(candidate.relative_to(root)))
    return sorted(found - set(expected))


def generator_blob_error(body):
    if body is None:
        return "generator missing: scripts/sync-agent-adapters"
    if len(body.encode("utf-8")) < 20000:
        return "generator is implausibly small; required synchronization logic is missing"
    try:
        ast.parse(body, filename=GENERATOR_PATH)
    except SyntaxError as exc:
        return f"generator is not valid Python at line {exc.lineno}: {exc.msg}"
    required_markers = (
        'MANIFEST_PATH = "ai/AGENT_ROUTES.json"',
        "FIRST_TURN_ACTION_TEXT = {",
        "FALLBACK_ACTION_TEXT = {",
        "def load_manifest(",
        "def render_surfaces(",
        "def selfcheck(",
        "def markdown_visible_text(",
        "def render_skill_adapter(",
        "def skill_frontmatter_error(",
        'SKILL_ADAPTER_ROOT = ".agents/skills/"',
        "def main(",
        'action.add_argument("--write"',
        'parser.add_argument("--staged"',
    )
    missing = [marker for marker in required_markers if marker not in body]
    if missing:
        return "generator lacks required control markers: " + ", ".join(missing)
    return None


def markdown_visible_text(body):
    visible = HTML_COMMENT.sub("", body)
    if "<!--" in visible or "-->" in visible:
        return None
    kept = []
    fence_char = None
    fence_length = 0
    for line in visible.splitlines(keepends=True):
        if fence_char is None:
            match = re.match(r"^[ \t]{0,3}(`{3,}|~{3,})", line)
        else:
            match = None
            closing_line = line.rstrip("\r\n")
            if re.fullmatch(
                rf"[ \t]{{0,3}}{re.escape(fence_char)}{{{fence_length},}}[ \t]*",
                closing_line,
            ):
                fence_char = None
                fence_length = 0
                continue
        if match is not None:
            marker = match.group(1)
            fence_char = marker[0]
            fence_length = len(marker)
            continue
        if fence_char is None:
            kept.append(line)
    if fence_char is not None:
        return None
    return "".join(kept)


def content_floor_error(rel, body):
    floor = CONTENT_FLOORS.get(rel)
    if floor is None or body is None:
        return None
    if rel == "skills/daily-log/SKILL.md":
        raw_lines = body.splitlines()
        if not raw_lines or raw_lines[0].strip() != "---":
            return f"{rel} must start with YAML frontmatter"
        try:
            frontmatter_end = next(
                index for index, line in enumerate(raw_lines[1:], 1) if line.strip() == "---"
            )
        except StopIteration:
            return f"{rel} has unclosed YAML frontmatter"
        names = [line.strip() for line in raw_lines[1:frontmatter_end] if line.strip().startswith("name:")]
        if names != ["name: daily-log"]:
            return f"{rel} frontmatter must contain exactly one name: daily-log"
    visible = markdown_visible_text(body)
    if visible is None:
        return f"{rel} has an unclosed HTML comment or fenced block"
    if len(visible.encode("utf-8")) < floor["min_bytes"]:
        return f"{rel} has too little visible canonical behavior outside comments and fenced blocks"
    visible_lines = [line.strip() for line in visible.splitlines()]
    missing_headings = [
        heading for heading in floor["heading_prefixes"]
        if not any(line == heading or line.startswith(heading + " ") for line in visible_lines)
    ]
    if missing_headings:
        return f"{rel} lacks required visible headings: " + ", ".join(missing_headings)
    missing = [marker for marker in floor["markers"] if marker not in visible]
    if missing:
        return f"{rel} lacks compatibility markers: " + ", ".join(missing)
    return None


def canonical_skill_dirs(root, staged=False):
    """Directory name of every skills/<name>/SKILL.md that exists, worktree or index.

    The registry-to-disk direction is covered by skill_frontmatter_error (an adapter must have a
    canonical skill, and that skill must carry name/description frontmatter). This is the
    disk-to-registry direction: a new skills/<name>/SKILL.md with no skill_adapters row generates
    no adapter, so no skills host can discover it, and every check would still report clean
    because there is no surface to be stale. Same silent-invisibility class, other door.
    """
    if staged:
        result = subprocess.run(
            ["git", "-C", str(root), "ls-files", "-z", "--", SKILL_CANONICAL_ROOT.rstrip("/")],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            raise ConfigError(
                f"git ls-files failed while listing canonical skills: {result.stderr.strip()[:200]}"
            )
        names = [item for item in result.stdout.split("\0") if item]
    else:
        base = root / SKILL_CANONICAL_ROOT.rstrip("/")
        if not base.is_dir():
            return set()
        names = [
            str(path.relative_to(root))
            for path in base.glob("*/SKILL.md")
            if path.is_file() and not path.is_symlink()
        ]
    found = set()
    for name in names:
        parts = PurePosixPath(name).parts
        if len(parts) == 3 and parts[2] == "SKILL.md":
            found.add(parts[1])
    return found


def skill_frontmatter_error(rel, body):
    """Every skill an adapter routes to must carry the metadata a skills host requires.

    Agent Skills hosts key discovery on the SKILL.md `name` and `description`. A canonical file
    without them is invisible on every host that reads .agents/skills or .claude/skills. The
    adapter cannot substitute for it: the adapter is what points AT this file, and the canonical
    file is what a reader lands on. Only presence is checked; a vendored skill may keep its
    upstream name (skills/ogilvy/SKILL.md declares ogilvy-copywriting) because the folder name,
    not the frontmatter name, is what the adapter and the registry key on.
    """
    lines = body.splitlines()
    if not lines or lines[0].strip() != "---":
        return f"{rel} must start with YAML frontmatter (a skills host needs name and description)"
    try:
        end = next(index for index, line in enumerate(lines[1:], 1) if line.strip() == "---")
    except StopIteration:
        return f"{rel} has unclosed YAML frontmatter"
    keys = [
        line.split(":", 1)[0].strip()
        for line in lines[1:end]
        if ":" in line and not line.startswith((" ", "\t", "#"))
    ]
    missing = [key for key in ("name", "description") if key not in keys]
    if missing:
        return f"{rel} frontmatter lacks required skill keys: " + ", ".join(missing)
    return None


def check_required(root, manifest, staged=False):
    failures = []
    contract = manifest["canonical_contract"]
    contract_body = read_text(root, contract, staged=staged)
    if contract_body is None:
        failures.append(f"canonical contract missing: {contract}")
    else:
        floor_error = content_floor_error(contract, contract_body)
        if floor_error:
            failures.append(floor_error)
    for item in manifest["required_existing"]:
        body = read_text(root, item["path"], staged=staged)
        if body is None:
            failures.append(f"required file missing: {item['path']}")
        else:
            if item["must_contain"] not in body:
                failures.append(f"required pointer missing: {item['path']} must contain {item['must_contain']!r}")
    for workflow in manifest["workflows"]:
        body = read_text(root, workflow["canonical_skill"], staged=staged)
        if body is None:
            failures.append(f"canonical skill missing: {workflow['canonical_skill']}")
        else:
            floor_error = content_floor_error(workflow["canonical_skill"], body)
            if floor_error:
                failures.append(floor_error)
    checked_canonicals = set()
    for entry in manifest["generated_surfaces"]["skill_adapters"]:
        canonical = entry["canonical_skill"]
        if canonical in checked_canonicals:
            continue
        checked_canonicals.add(canonical)
        body = read_text(root, canonical, staged=staged)
        if body is None:
            failures.append(f"skill adapter {entry['path']} points at a missing canonical skill: {canonical}")
            continue
        frontmatter_error = skill_frontmatter_error(canonical, body)
        if frontmatter_error:
            failures.append(frontmatter_error)
    declared_skills = {
        entry["skill"] for entry in manifest["generated_surfaces"]["skill_adapters"]
    }
    for workflow in manifest["workflows"]:
        parts = PurePosixPath(workflow["canonical_skill"]).parts
        if len(parts) == 3 and parts[0] == SKILL_CANONICAL_ROOT.rstrip("/"):
            declared_skills.add(parts[1])
    for name in sorted(canonical_skill_dirs(root, staged=staged) - declared_skills):
        failures.append(
            f"{SKILL_CANONICAL_ROOT}{name}/SKILL.md exists but has no skill_adapters row in "
            f"{MANIFEST_PATH}, so no skills host can discover it. Add the row, then re-run --write"
        )
    for rel, reason in RESERVED_SURFACES.items():
        if read_text(root, rel, staged=staged) is not None:
            failures.append(f"reserved platform surface must remain absent: {rel} ({reason})")
    generator_body = read_text(root, GENERATOR_PATH, staged=staged)
    generator_error = generator_blob_error(generator_body)
    if generator_error:
        failures.append(generator_error)
    if generator_body is not None:
        if staged:
            if git_index_mode(root, GENERATOR_PATH) != "100755":
                failures.append("staged generator must retain executable mode 100755")
        elif not ((root / GENERATOR_PATH).stat().st_mode & 0o111):
            failures.append("generator must remain executable: scripts/sync-agent-adapters")
    if staged and generator_body is not None:
        running_generator = Path(__file__).resolve().read_text(encoding="utf-8")
        if generator_body != running_generator:
            failures.append(
                "staged generator differs from the generator being executed; stage the current "
                "scripts/sync-agent-adapters before committing"
            )
    return failures


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    action = parser.add_mutually_exclusive_group()
    action.add_argument("--check", action="store_true", help="verify generated surfaces, the default")
    action.add_argument("--write", action="store_true", help="write generated surfaces")
    parser.add_argument("--staged", action="store_true", help="check the git index instead of the worktree")
    parser.add_argument("--root", type=Path, help="repository root to inspect")
    args = parser.parse_args()
    if args.staged and args.write:
        return die("--staged is valid only with --check")
    root = (args.root or Path(__file__).resolve().parent.parent).resolve()
    if not root.is_dir():
        return die(f"root does not exist: {root}")
    try:
        manifest = load_manifest(root, staged=args.staged)
        if manifest is None:
            return die(f"required manifest missing: {MANIFEST_PATH}", code=1)
        outputs = render_surfaces(manifest)
        internal = selfcheck(manifest, outputs)
    except (ConfigError, OSError, UnicodeError) as exc:
        return die(str(exc))
    if internal:
        return die("; ".join(internal))
    try:
        failures = check_required(root, manifest, staged=args.staged)
    except (ConfigError, OSError, UnicodeError) as exc:
        return die(str(exc))
    if args.write:
        if failures:
            for failure in failures:
                print(f"agent-adapters: {failure}", file=sys.stderr)
            return die("required inputs failed verification; generated files were not written", code=1)
        try:
            orphans = generated_orphans(root, outputs)
        except ConfigError as exc:
            return die(str(exc))
        if orphans:
            return die("orphan generated surfaces require deliberate removal: " + ", ".join(orphans), code=1)
        changed = []
        for rel, expected in outputs.items():
            try:
                current = read_text(root, rel)
                current_mode = generated_surface_mode(root, rel)
            except (ConfigError, OSError, UnicodeError) as exc:
                return die(str(exc))
            if current == expected and current_mode == "0644":
                continue
            if current is not None and HEADER not in current:
                return die(f"refusing to overwrite unmanaged file: {rel}", code=1)
            path = root / rel
            try:
                path.parent.mkdir(parents=True, exist_ok=True)
                if current != expected:
                    path.write_text(expected, encoding="utf-8")
                path.chmod(0o644)
            except OSError as exc:
                return die(f"could not write {rel}: {type(exc).__name__}: {exc}")
            changed.append(rel)
        if changed:
            print("agent-adapters: updated " + ", ".join(changed))
        else:
            print(f"agent-adapters: clean ({len(outputs)} generated surfaces)")
        return 0
    try:
        for rel, expected in outputs.items():
            current = read_text(root, rel, staged=args.staged)
            if current is None:
                failures.append(f"generated surface missing: {rel}")
            elif current != expected:
                failures.append(f"generated surface stale: {rel}")
            elif generated_surface_mode(root, rel, staged=args.staged) != ("100644" if args.staged else "0644"):
                failures.append(f"generated surface wrong mode: {rel} must be 100644")
    except (ConfigError, OSError, UnicodeError) as exc:
        return die(str(exc))
    try:
        failures.extend(
            f"orphan generated surface: {rel}"
            for rel in generated_orphans(root, outputs, staged=args.staged)
        )
    except ConfigError as exc:
        return die(str(exc))
    if failures:
        for failure in failures:
            print(f"agent-adapters: {failure}", file=sys.stderr)
        print("agent-adapters: run scripts/sync-agent-adapters --write", file=sys.stderr)
        return 1
    print(f"agent-adapters: clean ({len(outputs)} generated surfaces)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
