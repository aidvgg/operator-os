#!/usr/bin/env python3
"""Preserve credential detections while allowing literal-prefix regex searches."""
import importlib.machinery
import importlib.util
import io
import re
import subprocess
import tempfile
import unittest
import zipfile
from pathlib import Path


doctor_path = Path(__file__).with_name("repo-doctor")
loader = importlib.machinery.SourceFileLoader("doctor_secret_prefix_test", str(doctor_path))
spec = importlib.util.spec_from_loader(loader.name, loader)
doctor = importlib.util.module_from_spec(spec)
loader.exec_module(doctor)

# The pre-optimization expressions are an independent behavioral oracle.
LEGACY = [
    re.compile(r"\bgh[pousr]_[A-Za-z0-9]{36,}\b|\bgithub_pat_[A-Za-z0-9_]{50,}\b"),
    re.compile(r"\bsk-[A-Za-z0-9_-]{20,}\b"),
    re.compile(r"\bre_[A-Za-z0-9]{16,}\b"),
    re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b"),
    re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b"),
]
BOUNDARIES = ("", " ", "\n", "!", "_", "a", "0", "é", "İ", "ı", "ſ", "K",
              "\u0301", "\u200b", "😄")


def examples():
    for variant in "pousr":
        yield 0, "gh" + variant + "_", 36
    yield 0, "github_pat_", 50
    yield 1, "sk-", 20
    yield 2, "re_", 16
    for variant in "baprs":
        yield 3, "xox" + variant + "-", 10
    yield 4, "AKIA", 16


class CredentialSearch(unittest.TestCase):
    def assert_matches_legacy(self, index, text):
        expected = [(m.span(), m.groups()) for m in LEGACY[index].finditer(text)]
        actual = [(m.span(), m.groups())
                  for m in doctor.SECRET_PATTERNS[6 + index].finditer(text)]
        self.assertEqual(expected, actual)

    def test_all_prefixes_keep_length_and_unicode_boundaries(self):
        for index, prefix, minimum in examples():
            for size in (minimum - 1, minimum, minimum + 1):
                token = prefix + "A" * size
                for left in BOUNDARIES:
                    for right in BOUNDARIES:
                        with self.subTest(prefix=prefix, size=size, left=left, right=right):
                            self.assert_matches_legacy(index, left + token + right + " | " + token)

    def test_jwt_keeps_each_segment_and_boundaries(self):
        for size in (9, 10, 11):
            token = "eyJ" + "A" * size + "." + "B" * size + "." + "C" * size
            for left in BOUNDARIES:
                for right in BOUNDARIES:
                    with self.subTest(size=size, left=left, right=right):
                        self.assert_matches_legacy(5, left + token + right)
        for token in ("eyJ" + "A" * 10 + "." + "B" * 9 + "." + "C" * 10,
                      "eyJ" + "A" * 10 + "." + "B" * 10 + "." + "C" * 9):
            self.assertIsNone(doctor.SECRET_PATTERNS[11].search(token))

    def test_word_prefix_still_rejects_and_punctuation_still_detects(self):
        for index, prefix, size in examples():
            pattern = doctor.SECRET_PATTERNS[6 + index]
            token = prefix + "A" * size
            for left in ("x", "0", "_", "é", "İ", "ı", "ſ", "K"):
                with self.subTest(prefix=prefix, left=left):
                    self.assertIsNone(pattern.search(left + token))
            for left in ("", "!", "\n", "\u0301", "😄"):
                with self.subTest(prefix=prefix, left=left):
                    self.assertEqual((len(left), len(left + token)),
                                     pattern.search(left + token).span())

    def test_case_sensitive_prefixes_remain_case_sensitive(self):
        for index, prefix, size in examples():
            changed = prefix.swapcase() + "A" * size
            self.assertIsNone(doctor.SECRET_PATTERNS[6 + index].search(changed))

    def test_office_payload_keeps_secret_match(self):
        token = "sk-" + "A" * 20
        body = io.BytesIO()
        with zipfile.ZipFile(body, "w") as archive:
            archive.writestr("word/document.xml", "<document><body><p>" + token
                             + "</p></body></document>")
        valid, text = doctor.office_ok(body.getvalue(), ".docx")
        self.assertTrue(valid)
        self.assertIsNotNone(doctor.SECRET_PATTERNS[7].search(text))
        self.assert_matches_legacy(1, text)

    def test_staged_scanner_reports_original_secret_offset(self):
        with tempfile.TemporaryDirectory(prefix="doctor-secret-prefix-") as directory:
            root = Path(directory)
            subprocess.run(["git", "init", "-q"], cwd=root, check=True)
            target = root / "knowledge" / "example.md"
            target.parent.mkdir()
            target.write_text("start " + "sk-" + "A" * 20 + "\n")
            subprocess.run(["git", "add", "--", "knowledge/example.md"], cwd=root, check=True)
            result = subprocess.run(["python3", str(doctor_path), "--staged"],
                                    cwd=root, capture_output=True, text=True)
            self.assertEqual(1, result.returncode, result.stdout + result.stderr)
            self.assertIn("secrets: knowledge/example.md matches a secret shape near offset 6",
                          result.stdout)


if __name__ == "__main__":
    unittest.main()
