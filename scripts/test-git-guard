# settings file, hook file, exact surfaces, match-all requirement
WIRING = [
    (SETTINGS, GIT_HOOK, ("Bash",), False),
    (SETTINGS, ENV_HOOK, (), True),
    (CODEX_HOOKS, GIT_HOOK, ("Bash",), False),
