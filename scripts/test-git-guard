#!/usr/bin/env python3
"""Fixture runner for both PreToolUse guards: destructive-git and env-file.

First standing member of the guardrail-fixture suite
(knowledge/ops/os-roadmap.md section 9: tests that the checks themselves still
fire). Asserts six things:

  1. every known-bad command string is DENIED by the guard that owns it
     (.claude/hooks/deny-destructive-git.py for git and sweep staging,
     .claude/hooks/deny-env-access.py for .env access),
  2. every known-good command string is ALLOWED by both,
  3. target fields, selectors, lists, maps and command strings are scanned,
     while known prose and code fields remain writable. Codex apply_patch calls
     are judged by every envelope header path, never by the patch body,
  4. malformed hook input, or a missing or broken scripts/lib/agent_guards,
     fails closed with a valid deny response,
  5. both hooks are executable and wired to their host-specific tool surfaces
     on Claude Code, Codex and Grok Build,
  6. each hook agrees with the shared library on verdict and deny reason.

Honest limit: this proves script behavior and file-level wiring, not that a host
has trusted and armed its hooks for the current session. Run: scripts/test-git-guard
Exit 0 all green, 1 on any failure (each failure printed). 3.9-clean.
"""
import json
import os
import pwd
import shlex
import shutil
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
GIT_HOOK = os.path.join(ROOT, ".claude", "hooks", "deny-destructive-git.py")
ENV_HOOK = os.path.join(ROOT, ".claude", "hooks", "deny-env-access.py")
SETTINGS = os.path.join(ROOT, ".claude", "settings.json")
CODEX_HOOKS = os.path.join(ROOT, ".codex", "hooks.json")
USER_NAME = pwd.getpwuid(os.getuid()).pw_name
USER_HOME = os.path.expanduser("~" + USER_NAME)
ROOT_GLOB_FROM_HOME = shlex.quote(os.path.relpath(ROOT, USER_HOME)) + "/.e*"


def call(tool_name, **tool_input):
    """A Claude/Codex PreToolUse envelope, snake_case tool_name and all."""
    return {"tool_name": tool_name, "tool_input": tool_input}


def call_grok(tool_name, **tool_input):
    """A Grok Build PreToolUse envelope, camelCase toolName / toolInput."""
    return {"toolName": tool_name, "toolInput": tool_input}


def patch(*lines):
    """A Codex apply_patch command string: the whole patch in one blob."""
    return "\n".join(("*** Begin Patch",) + lines + ("*** End Patch",))


# --- destructive-git guard, shell command strings (tool_name omitted, which is
# --- how an unrecognized or absent tool_name must behave: still scanned).
GIT_DENY = [
    # Backslash line continuation is shell whitespace, not a segment boundary.
    # An earlier revision split on the raw newline and orphaned the flag from
    # its verb, so every rule below was one trailing backslash away from
    # passing. No incident, found by review.
    "git reset \\\n  --hard HEAD",
    "git push \\\n  --force origin main",
    "git add \\\n  -A",
    "git commit \\\n  --no-verify -m x",
    # worktree destruction
    "git reset --hard",
    "git reset --hard HEAD~1",
    "git -C /some/other/repo reset --hard origin/main",
    "git clean -fd",
    "git clean -ffdx",
    "git clean --force",
    "git checkout .",
    "git checkout -- outputs/file.md",
    "git checkout HEAD -- scripts/repo-doctor",
