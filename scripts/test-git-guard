MALFORMED_ENV_DENY = [
    ("invalid JSON", "{"),
    ("top-level list", "[]"),
    ("non-object tool_input", json.dumps({
        "tool_name": "Bash", "tool_input": ["cat", ".env.local"]})),
    ("non-string Bash command", json.dumps({
        "tool_name": "Bash", "tool_input": {"command": 42}})),
    ("object-valued Bash command", json.dumps({
        "tool_name": "Bash", "tool_input": {"command": {"argv": "git status"}}})),
    ("object-valued Glob pattern", json.dumps({
        "tool_name": "Glob", "tool_input": {"pattern": {"include": "*.md"}}})),
    ("object-valued Read file_path", json.dumps({
        "tool_name": "Read", "tool_input": {"file_path": {"name": "notes.md"}}})),
    ("numeric unknown-tool path", json.dumps({
        "tool_name": "mcp__filesystem__read", "tool_input": {"path": 42}})),
    ("object member in defensive argv", json.dumps({
        "tool_name": "Bash", "tool_input": {"command": [{"argv": "git status"}]}})),
    ("numeric member in defensive argv", json.dumps({
        "tool_name": "Bash", "tool_input": {"command": [42]}})),
]

# The git guard has no envelope to judge when the JSON itself is broken, so it
# fails closed too rather than exiting without JSON (which fails open).
MALFORMED_GIT_DENY = [
    ("invalid JSON", "{"),
]


# Deny-REASON checks: a fail-closed on unparseable input must deny
# with a reason that does NOT claim a protected-path match, so an agent does not
# misread a parse failure as a key-file access. Each row is
# (label, command, expect_deny, kind) where kind is "match" (the key-file
# reason), "failclosed" (the neutral parse/analysis reason), or None (allow).
KEY_REASON_MARK = "live API keys"
FAILCLOSED_MARK = "not a detected .env access"
REASON_CHECKS = [
    ("bare-delimiter cmd-sub reading the key file denies as a real match",
     "cat <<EOF\n$(cat .env.local)\nEOF", True, "match"),
    ("bare-delimiter apostrophe body fails closed, not reported as a match",
     "cat <<EOF\nthis body won't parse\nEOF", True, "failclosed"),
    ("plain unbalanced quote fails closed, not reported as a match",
     "git commit -m 'unterminated", True, "failclosed"),
    ("quoted-delimiter apostrophe body is allowed outright",
     "git commit -F - <<'EOF'\nfix the row's status\nEOF", False, None),
]


def hook_reason(hook, payload):
    """Return (verdict, reason) so a deny's phrasing can be asserted."""
    proc = subprocess.run(
        [sys.executable, hook],
        input=json.dumps(payload),
        capture_output=True, text=True, cwd=ROOT,
    )
    if proc.returncode != 0:
        return ("invalid", "")
    out = proc.stdout.strip()
    if not out:
        return ("allow", "")
    try:
        info = json.loads(out)["hookSpecificOutput"]
        verdict = "deny" if info["permissionDecision"] == "deny" else "invalid"
        return (verdict, info.get("permissionDecisionReason", ""))
    except Exception:
        return ("invalid", out)


def hook_result_raw(hook, raw_input):
    proc = subprocess.run(
        [sys.executable, hook],
        input=raw_input,
        capture_output=True, text=True, cwd=ROOT,
    )
    if proc.returncode != 0:
        return "invalid"
    out = proc.stdout.strip()
    if not out:
        return "allow"
    try:
        decision = json.loads(out)["hookSpecificOutput"]["permissionDecision"]
    except Exception:
        return "invalid"
    return "deny" if decision == "deny" else "invalid"


def hook_result(hook, payload):
    return hook_result_raw(hook, json.dumps(payload))


def check(failures, hook, label, payload, expect_deny):
    verdict = hook_result(hook, payload)
    if verdict == "invalid":
        got = "crashed/garbled"
    elif verdict == ("deny" if expect_deny else "allow"):
        return
    else:
        got = "denied" if verdict == "deny" else "allowed"
    failures.append("%s should %s but %s: %s" % (
        os.path.basename(hook), "DENY" if expect_deny else "ALLOW", got, label))


def check_worktree_family(failures):
    """Exercise family discovery using metadata only, never protected files."""
    with tempfile.TemporaryDirectory(prefix="guard-worktrees-") as temp:
        primary = os.path.join(temp, "primary")
        current = os.path.join(temp, "current")
        sibling = os.path.join(temp, "sibling")
        common = os.path.join(primary, ".git")
        current_admin = os.path.join(common, "worktrees", "current")
        sibling_admin = os.path.join(common, "worktrees", "sibling")
        hook_dir = os.path.join(current, ".claude", "hooks")
        os.makedirs(current_admin)
        os.makedirs(sibling_admin)
        os.makedirs(hook_dir)
        os.makedirs(sibling)

        current_marker = os.path.join(current, ".git")
        sibling_marker = os.path.join(sibling, ".git")
        with open(current_marker, "w", encoding="utf-8") as handle:
            handle.write("gitdir: %s\n" % current_admin)
        with open(sibling_marker, "w", encoding="utf-8") as handle:
            handle.write("gitdir: %s\n" % sibling_admin)
        for admin, marker in ((current_admin, current_marker),
                              (sibling_admin, sibling_marker)):
            with open(os.path.join(admin, "commondir"), "w", encoding="utf-8") as handle:
                handle.write("../..\n")
            with open(os.path.join(admin, "gitdir"), "w", encoding="utf-8") as handle:
                handle.write(marker + "\n")

        copied_hook = os.path.join(hook_dir, os.path.basename(ENV_HOOK))
        shutil.copy2(ENV_HOOK, copied_hook)
        # Hooks are thin adapters over scripts/lib/agent_guards; copy the library
        # into the synthetic tree so import-by-repo-root still resolves.
        lib_src = os.path.join(ROOT, "scripts", "lib")
        lib_dst = os.path.join(current, "scripts", "lib")
        shutil.copytree(lib_src, lib_dst)
        for label, root in (("synthetic current worktree glob", current),
                            ("synthetic primary worktree glob", primary),
                            ("synthetic sibling worktree glob", sibling)):
            check(failures, copied_hook, label,
                  call("Glob", path=root, pattern=".e*"), True)
        check(failures, copied_hook, "synthetic sibling safe glob",
              call("Glob", path=sibling, pattern="**/*.md"), False)
        check(failures, copied_hook, "synthetic sibling relative dot-segment glob",
              call("Bash", command="cd %s; ls .claude/../.e*" % sibling), True)
        check(failures, copied_hook, "synthetic sibling absolute dot-segment glob",
              call("Bash", command="ls %s/.claude/../.e*" % sibling), True)
        check(failures, copied_hook, "synthetic wildcard parent is ambiguous",
              call("Bash", command="cd %s; ls '*/../notes/*.md'" % sibling), True)
        check(failures, copied_hook, "synthetic safe dot-segment glob",
              call("Bash", command="cd %s; ls .claude/../docs/*.md" % sibling), False)

        # A linked worktree nested under `.claude/worktrees/` puts protected
        # `.env` paths below `.claude`, and Python fnmatch lets `*` span
        # slashes, so `.claude*` is a real selector of a protected path. Kept
        # synthetic: the verdict depends on where the worktrees live.
        nested = os.path.join(current, ".claude", "worktrees", "nested")
        nested_admin = os.path.join(common, "worktrees", "nested")
        os.makedirs(nested)
        os.makedirs(nested_admin)
        with open(os.path.join(nested_admin, "gitdir"), "w", encoding="utf-8") as handle:
            handle.write(os.path.join(nested, ".git") + "\n")
        check(failures, copied_hook, "synthetic nested worktree under .claude*",
              call("Bash", command="cd %s; ls -d .claude*" % current), True)

        with open(current_marker, "w", encoding="utf-8") as handle:
            handle.write("not a gitdir pointer\n")
        check(failures, copied_hook, "malformed synthetic Git metadata",
              call("Glob", path=current, pattern="**/*.md"), True)


IMPORT_FAILURES = ("missing", "broken")


def check_import_failure(failures):
    """A missing or broken guard library must still print a fail-closed deny."""
    for hook in (GIT_HOOK, ENV_HOOK):
        for case in IMPORT_FAILURES:
            with tempfile.TemporaryDirectory(prefix="guard-nolib-") as temp:
                hook_dir = os.path.join(temp, ".claude", "hooks")
                os.makedirs(hook_dir)
                copied_hook = os.path.join(hook_dir, os.path.basename(hook))
                shutil.copy2(hook, copied_hook)
                if case == "broken":
                    lib = os.path.join(temp, "scripts", "lib", "agent_guards")
                    os.makedirs(lib)
                    with open(os.path.join(lib, "__init__.py"), "w") as handle:
                        handle.write("raise RuntimeError('broken guard library')\n")
                verdict, reason = hook_reason(
                    copied_hook, {"tool_input": {"command": "git status"}})
                if verdict != "deny" or "failing closed" not in reason:
                    failures.append(
                        "%s with a %s library should fail closed but %s"
                        % (os.path.basename(hook), case, verdict))


def check_library_hook_parity(failures):
    """Library deny must match hook deny for shared fixtures (no drift)."""
    lib_dir = os.path.join(ROOT, "scripts", "lib")
    if lib_dir not in sys.path:
        sys.path.insert(0, lib_dir)
    from agent_guards.env import check_env_command, evaluate_env_envelope
    from agent_guards.git import check_git_command, evaluate_git_envelope

    def lib_git_denied(payload):
        return evaluate_git_envelope(payload) is not None

    def lib_env_denied(payload):
        return evaluate_env_envelope(payload, project_root=ROOT) is not None

    for command in GIT_DENY + GIT_ALLOW:
        payload = {"tool_input": {"command": command}}
        hook = hook_result(GIT_HOOK, payload) == "deny"
        lib = lib_git_denied(payload)
        if hook != lib:
            failures.append(
                "parity git: hook=%s lib=%s for %r"
                % ("deny" if hook else "allow", "deny" if lib else "allow", command))
        if hook:
            _, reason = hook_reason(GIT_HOOK, payload)
            lib_deny = check_git_command(command)
            if lib_deny is None or lib_deny.reason != reason:
                failures.append("parity git reason drift: %r" % command)

    for command in ENV_DENY + ENV_ALLOW:
        payload = {"tool_input": {"command": command}}
        hook = hook_result(ENV_HOOK, payload) == "deny"
        lib = lib_env_denied(payload)
        if hook != lib:
            failures.append(
                "parity env: hook=%s lib=%s for %r"
                % ("deny" if hook else "allow", "deny" if lib else "allow", command))
        if hook:
            _, reason = hook_reason(ENV_HOOK, payload)
            lib_deny = check_env_command(command, project_root=ROOT)
            if lib_deny is None or lib_deny.reason != reason:
                failures.append("parity env reason drift: %r" % command)

    for label, payload in GIT_DENY_CALLS + GIT_ALLOW_CALLS:
        hook = hook_result(GIT_HOOK, payload) == "deny"
        lib = lib_git_denied(payload)
        if hook != lib:
            failures.append(
                "parity git call: hook=%s lib=%s for %s"
                % ("deny" if hook else "allow", "deny" if lib else "allow", label))

    for label, payload in ENV_DENY_CALLS + ENV_ALLOW_CALLS:
        hook = hook_result(ENV_HOOK, payload) == "deny"
        lib = lib_env_denied(payload)
        if hook != lib:
            failures.append(
                "parity env call: hook=%s lib=%s for %s"
                % ("deny" if hook else "allow", "deny" if lib else "allow", label))



def main():
    failures = []

    for hook, denied, allowed, deny_calls, allow_calls in (
        (GIT_HOOK, GIT_DENY, GIT_ALLOW, GIT_DENY_CALLS, GIT_ALLOW_CALLS),
        (ENV_HOOK, ENV_DENY, ENV_ALLOW, ENV_DENY_CALLS, ENV_ALLOW_CALLS),
    ):
        for command in denied:
            check(failures, hook, command, {"tool_input": {"command": command}},
                  True)
        for command in allowed:
            check(failures, hook, command, {"tool_input": {"command": command}},
                  False)
        for label, payload in deny_calls:
            check(failures, hook, label, payload, True)
        for label, payload in allow_calls:
            check(failures, hook, label, payload, False)

    # cross-guard: an envelope reaches BOTH hooks, so anything one guard allows
    # must survive the other. This is what makes a doc that names .env.local
    # and quotes a destructive git command actually writable under Codex.
    for label, payload in GIT_ALLOW_CALLS:
        check(failures, ENV_HOOK, label + " [seen by env guard]", payload, False)
    for label, payload in ENV_ALLOW_CALLS:
        check(failures, GIT_HOOK, label + " [seen by git guard]", payload, False)

    for label, raw_input in MALFORMED_ENV_DENY:
        verdict = hook_result_raw(ENV_HOOK, raw_input)
        if verdict != "deny":
            failures.append(
                "%s should DENY but %s: %s"
                % (os.path.basename(ENV_HOOK), verdict, label))

    for label, raw_input in MALFORMED_GIT_DENY:
        verdict = hook_result_raw(GIT_HOOK, raw_input)
        if verdict != "deny":
            failures.append(
                "%s should DENY but %s: %s"
                % (os.path.basename(GIT_HOOK), verdict, label))

    for label, command, expect_deny, kind in REASON_CHECKS:
        verdict, reason = hook_reason(ENV_HOOK, {"tool_input": {"command": command}})
        want = "deny" if expect_deny else "allow"
        if verdict != want:
            failures.append("reason-check verdict: %s should %s but %s"
                            % (label, want, verdict))
            continue
        if kind == "match" and KEY_REASON_MARK not in reason:
            failures.append(
                "reason-check: %s should cite a protected-path match" % label)
        if kind == "failclosed" and (
                KEY_REASON_MARK in reason or FAILCLOSED_MARK not in reason):
            failures.append(
                "reason-check: %s should read as fail-closed, not a match" % label)

    check_library_hook_parity(failures)
    check_worktree_family(failures)
    check_import_failure(failures)

    # wiring: executable + referenced from each host's PreToolUse entry with the
    # host-specific matcher contract.
    loaded_settings = {}
    for settings_path, _, _, _ in WIRING:
        if settings_path in loaded_settings:
            continue
        try:
            with open(settings_path) as fh:
                loaded_settings[settings_path] = json.load(fh)
        except Exception as exc:
            loaded_settings[settings_path] = None
            failures.append("wiring: cannot parse %s: %s" % (settings_path, exc))

    for settings_path, hook, surfaces, match_all in WIRING:
        name = os.path.basename(hook)
        if not os.access(hook, os.X_OK):
            failures.append("wiring: hook is not executable: %s" % hook)
        settings = loaded_settings[settings_path]
        if settings is None:
            continue
        wired = False
        for entry in (settings.get("hooks") or {}).get("PreToolUse", []):
            matcher = entry.get("matcher") or ""
            matchers = matcher.split("|")
            if match_all and matcher != "*":
                continue
            if not match_all and matcher != "*" and not all(
                    s in matchers for s in surfaces):
                continue
            for entry_hook in entry.get("hooks", []):
                command = entry_hook.get("command", "").split("#", 1)[0]
                if entry_hook.get("type") == "command" and name in command:
                    wired = True
        if not wired:
            wanted = "*" if match_all else "|".join(surfaces)
            failures.append("wiring: no PreToolUse entry in %s matching %s references %s"
                            % (settings_path, wanted, name))

    # counted by the hook each assertion exercises, cross-guard runs included
    # worktree family: 8 deny and 2 allow checks in check_worktree_family
    git_deny = (len(GIT_DENY) + len(GIT_DENY_CALLS) + len(MALFORMED_GIT_DENY)
                + len(IMPORT_FAILURES))
    git_allow = len(GIT_ALLOW) + len(GIT_ALLOW_CALLS) + len(ENV_ALLOW_CALLS)
    env_deny = (len(ENV_DENY) + len(ENV_DENY_CALLS)
                + len(MALFORMED_ENV_DENY) + len(IMPORT_FAILURES) + 8)
    env_allow = len(ENV_ALLOW) + len(ENV_ALLOW_CALLS) + len(GIT_ALLOW_CALLS) + 2
    reason = len(REASON_CHECKS)
    wiring = 2 * len(WIRING)
    # parity: each shared command/call compared once (deny+allow lists + calls);
    # reason-string checks only fire on the deny subset but are counted in the
    # command loops as part of those same cases when denied.
    parity = (len(GIT_DENY) + len(GIT_ALLOW) + len(ENV_DENY) + len(ENV_ALLOW)
              + len(GIT_DENY_CALLS) + len(GIT_ALLOW_CALLS)
              + len(ENV_DENY_CALLS) + len(ENV_ALLOW_CALLS))
    total = git_deny + git_allow + env_deny + env_allow + reason + wiring + parity
    if failures:
        for line in failures:
            print("FAIL  %s" % line)
        print("test-git-guard: %d/%d assertions failed" % (len(failures), total))
        return 1
    print("test-git-guard: all %d assertions green (git %d deny / %d allow, "
          "env %d deny / %d allow, %d reason, %d wiring, %d lib-parity)" % (
              total, git_deny, git_allow, env_deny, env_allow, reason, wiring,
              parity))
    return 0


if __name__ == "__main__":
    sys.exit(main())
